<%- include('partials/header') %>

<div class="container py-5" style="min-height: 75vh;">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card shadow p-4 p-md-5 border-0">
        <div class="text-center mb-4">
          <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 shadow-sm" style="width: 60px; height: 60px; background: rgba(16, 185, 129, 0.12); color: #10b981; font-size: 1.8rem;">
            <i class="bi bi-key-fill"></i>
          </div>
          <h2 class="fw-bold mb-1" style="color: var(--secondary-color);">Nueva Contraseña</h2>
          <p class="text-muted small">Crea una contraseña segura para tu cuenta.</p>
        </div>

        <% if (locals.error) { %>
          <div class="alert alert-danger border-0 small py-3 mb-4 rounded-3 d-flex align-items-center">
            <i class="bi bi-exclamation-triangle-fill fs-5 me-2 flex-shrink-0"></i>
            <div><%= error %></div>
          </div>
        <% } %>
        
        <form action="/auth/reset-password/<%= token %>" method="POST" id="resetForm">
          <div class="mb-3">
            <label class="form-label text-muted small fw-bold">Nueva Contraseña</label>
            <div class="input-group">
              <input type="password" class="form-control form-control-lg" name="password" id="password" required minlength="6" placeholder="Mínimo 6 caracteres">
              <button class="btn btn-outline-secondary" type="button" onclick="togglePass('password', 'icon1')">
                <i class="bi bi-eye-fill text-muted" id="icon1"></i>
              </button>
            </div>
            <div class="form-text small">Debe tener al menos 6 caracteres.</div>
          </div>

          <div class="mb-4">
            <label class="form-label text-muted small fw-bold">Confirmar Contraseña</label>
            <div class="input-group">
              <input type="password" class="form-control form-control-lg" name="confirmPassword" id="confirmPassword" required minlength="6" placeholder="Repite tu contraseña">
              <button class="btn btn-outline-secondary" type="button" onclick="togglePass('confirmPassword', 'icon2')">
                <i class="bi bi-eye-fill text-muted" id="icon2"></i>
              </button>
            </div>
          </div>

          <button type="submit" class="btn btn-primary btn-lg w-100 py-3 mb-3 fw-bold rounded-pill shadow-sm">
            <i class="bi bi-check2-circle me-1"></i> Guardar Nueva Contraseña
          </button>
        </form>
        
        <div class="text-center mt-3 pt-3 border-top border-secondary border-opacity-10">
          <a href="/login" class="text-decoration-none small text-muted">
            <i class="bi bi-arrow-left me-1"></i> Volver a Iniciar Sesión
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function togglePass(inputId, iconId) {
    const input = document.getElementById(inputId);
    const icon = document.getElementById(iconId);
    if (input.type === 'password') {
      input.type = 'text';
      icon.classList.replace('bi-eye-fill', 'bi-eye-slash-fill');
    } else {
      input.type = 'password';
      icon.classList.replace('bi-eye-slash-fill', 'bi-eye-fill');
    }
  }

  document.getElementById('resetForm').addEventListener('submit', function(e) {
    const pass = document.getElementById('password').value;
    const confirm = document.getElementById('confirmPassword').value;
    if (pass !== confirm) {
      e.preventDefault();
      alert('Las contraseñas no coinciden. Por favor verifícalas.');
    }
  });
</script>

<%- include('partials/footer') %>
