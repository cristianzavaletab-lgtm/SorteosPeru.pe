<%- include('partials/header') %>

<style>
    :root {
        --glass-bg: rgba(18, 7, 32, 0.6);
        --glass-border: rgba(245, 197, 66, 0.1);
        --accent-primary: #5B21B6;
        --accent-secondary: #D946EF;
        --accent-gold: #F5C542;
        --accent-success: #10b981;
        --accent-danger: #f43f5e;
    }

    body {
        background: radial-gradient(circle at top right, var(--bg-darker), #0a0515);
        color: var(--text-light);
        overflow-x: hidden;
    }

    /* Professional Balance Pill */
    .balance-pill {
        display: inline-flex;
        align-items: center;
        background: rgba(18, 7, 32, 0.9);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 50px;
        padding: 6px 6px 6px 14px;
        box-shadow: 0 4px 25px rgba(0, 0, 0, 0.4), 0 0 15px rgba(91, 33, 182, 0.1);
        transition: all 0.3s ease;
    }

    .balance-pill:hover {
        border-color: var(--accent-gold);
        box-shadow: 0 4px 30px rgba(245, 197, 66, 0.2);
    }

    .balance-pill .star-icon {
        width: 28px; height: 28px;
        background: linear-gradient(135deg, #F5C542, #d97706);
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        margin-right: 10px;
        box-shadow: 0 0 10px rgba(245, 197, 66, 0.5);
    }

    .balance-pill .credits-text {
        font-weight: 800;
        letter-spacing: -0.5px;
        font-size: 1rem;
        color: #fff;
        margin-right: 12px;
    }

    .balance-pill .plus-btn {
        padding: 6px 16px;
        background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
        border-radius: 20px;
        color: #fff;
        font-weight: 800;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        text-decoration: none;
        border: 1px solid rgba(255, 255, 255, 0.2);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 12px rgba(91, 33, 182, 0.3);
    }

    .balance-pill .plus-btn:hover {
        transform: scale(1.05);
        box-shadow: 0 6px 20px rgba(91, 33, 182, 0.5);
        filter: brightness(1.1);
    }

    /* Page Header */
    .rewards-hero {
        padding: 2rem 0;
        text-align: left;
    }
    .hero-icon-box {
        width: 64px; height: 64px;
        background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
        border-radius: 20px;
        display: flex; align-items: center; justify-content: center;
        margin-bottom: 1rem;
        box-shadow: 0 10px 30px rgba(91, 33, 182, 0.4);
        position: relative;
    }
    .hero-icon-box::after {
        content: ''; position: absolute; inset: -5px;
        background: inherit; filter: blur(15px); opacity: 0.3; z-index: -1;
    }

    /* Professional Game Cards */
    .premium-card {
        background: var(--glass-bg);
        backdrop-filter: blur(20px);
        border: 1px solid var(--glass-border);
        border-radius: 30px;
        overflow: hidden;
        margin-bottom: 2rem;
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.3);
        transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .premium-card:hover {
        transform: translateY(-5px);
        border-color: rgba(255, 255, 255, 0.15);
    }

    .card-header-accent {
        padding: 1.5rem 2rem;
        display: flex; justify-content: space-between; align-items: center;
        background: linear-gradient(to right, rgba(255,255,255,0.03), transparent);
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .card-title {
        font-weight: 800; font-size: 1.1rem; color: #fff; margin: 0;
        display: flex; align-items: center; gap: 10px;
    }

    .status-badge {
        font-size: 0.65rem; font-weight: 900; text-transform: uppercase;
        padding: 5px 12px; border-radius: 50px; letter-spacing: 1px;
    }
    .badge-free { background: rgba(16, 185, 129, 0.15); color: var(--accent-success); border: 1px solid rgba(16,185,129,0.3); }
    .badge-cost { background: rgba(217, 70, 239, 0.15); color: var(--accent-secondary); border: 1px solid rgba(217,70,239,0.3); }

    .card-body-content {
        padding: 2rem;
        text-align: center;
    }

    /* Gaming Buttons */
    .action-btn {
        width: 100%;
        padding: 1.1rem;
        border-radius: 50px;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        font-size: 0.9rem;
        border: none;
        color: #fff;
        cursor: pointer;
        transition: all 0.3s;
        display: flex; align-items: center; justify-content: center; gap: 10px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
    }
    .action-btn:hover:not(:disabled) {
        transform: translateY(-3px);
        box-shadow: 0 12px 25px rgba(0, 0, 0, 0.4);
    }
    .action-btn:disabled {
        background: #1e1235 !important;
        color: #475569 !important;
        cursor: not-allowed;
        box-shadow: none;
        opacity: 0.7;
    }

    .btn-gold { background: linear-gradient(135deg, #d97706, #fbbf24); }
    .btn-blue { background: linear-gradient(135deg, #5B21B6, #D946EF); }
    .btn-purple { background: linear-gradient(135deg, #5B21B6, #7c3aed); }
    .btn-rose { background: linear-gradient(135deg, #D946EF, #f43f5e); }

    /* Streak Bar Professional */
    .streak-container {
        position: relative; padding: 1rem 0;
    }
    .streak-line {
        position: absolute; top: 32px; left: 10%; right: 10%; height: 4px;
        background: rgba(255,255,255,0.05); border-radius: 10px; z-index: 0;
    }
    .streak-progress {
        position: absolute; top: 0; left: 0; height: 100%;
        background: linear-gradient(to right, var(--accent-success), var(--accent-primary));
        border-radius: 10px; transition: width 1s ease;
    }
    .streak-dots {
        display: flex; justify-content: space-between; position: relative; z-index: 1;
    }
    .streak-node {
        width: 44px; text-align: center;
    }
    .node-circle {
        width: 36px; height: 36px; border-radius: 50%;
        background: #1e1235; color: #a89cc2;
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 8px; font-weight: 800; font-size: 0.8rem;
        border: 3px solid transparent; transition: all 0.4s;
    }
    .node-circle.active {
        background: #fff; color: var(--accent-primary);
        box-shadow: 0 0 20px rgba(255,255,255,0.5);
        border-color: var(--accent-primary);
        transform: scale(1.1);
    }
    .node-circle.done {
        background: var(--accent-success); color: #fff;
        box-shadow: 0 0 15px rgba(16, 185, 129, 0.4);
    }

    /* Floating Animations */
    @keyframes float {
        0%, 100% { transform: translateY(0) rotate(0deg); }
        50% { transform: translateY(-12px) rotate(2deg); }
    }
    .floating-img { animation: float 4s ease-in-out infinite; }

    /* Cards Game Pro */
    .card-slot { perspective: 1000px; width: 100px; height: 140px; cursor: pointer; }
    .card-slot-inner {
        position: relative; width: 100%; height: 100%;
        transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
        transform-style: preserve-3d;
    }
    .card-slot.flipped .card-slot-inner { transform: rotateY(180deg); }
    .card-slot-face {
        position: absolute; width: 100%; height: 100%;
        backface-visibility: hidden; border-radius: 18px;
        display: flex; align-items: center; justify-content: center;
        border: 2px solid rgba(255,255,255,0.1);
    }
    .face-front {
        background: linear-gradient(145deg, #2A1E3F, #5B21B6);
        color: rgba(245,197,66,0.2); font-size: 2.5rem; font-weight: 900;
        box-shadow: inset 0 0 25px rgba(0,0,0,0.5);
    }
    .face-front::after {
        content: '\F555'; font-family: 'bootstrap-icons';
        font-size: 1.5rem; opacity: 0.1;
    }
    .face-back {
        background: linear-gradient(145deg, #120720, #2A1E3F);
        color: var(--accent-gold); font-size: 1.8rem; font-weight: 900;
        transform: rotateY(180deg); border-color: var(--accent-gold);
        box-shadow: 0 0 25px rgba(251, 191, 36, 0.2);
    }

    /* Wheel Overlay Pro */
    #wheel {
        border: 10px solid #120720;
        box-shadow: 0 0 50px rgba(0,0,0,0.5), 0 0 30px rgba(91, 33, 182, 0.2);
    }

    /* Doble o Nada UI */
    .bet-selector {
        display: flex; justify-content: center; gap: 10px; margin-bottom: 2rem;
    }
    .bet-option {
        padding: 8px 15px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.1);
        background: rgba(255,255,255,0.05); color: #fff; font-weight: 700; cursor: pointer;
        transition: all 0.3s;
    }
    .bet-option.active {
        background: var(--accent-gold); border-color: var(--accent-gold); color: #120720;
        box-shadow: 0 0 15px rgba(245, 197, 66, 0.4);
    }

    .gamble-card {
        width: 140px; height: 200px; margin: 0 auto 2rem; perspective: 1000px;
    }
    .gamble-card-inner {
        width: 100%; height: 100%; transition: transform 0.8s; transform-style: preserve-3d;
        position: relative;
    }
    .gamble-card.flipped .gamble-card-inner { transform: rotateY(180deg); }
    .gamble-card-face {
        position: absolute; width: 100%; height: 100%; backface-visibility: hidden;
        border-radius: 15px; display: flex; align-items: center; justify-content: center;
        border: 3px solid rgba(255,255,255,0.1);
    }
    .gamble-front {
        background: linear-gradient(135deg, #2A1E3F, #120720);
        color: rgba(245,197,66,0.15); font-size: 4rem; font-weight: 900;
    }
    .gamble-back {
        background: #fff; transform: rotateY(180deg); font-size: 2.5rem; font-weight: 900;
    }
    .gamble-back.roja { color: #f43f5e; border-color: #f43f5e; }
    .gamble-back.negra { color: #1e293b; border-color: #1e293b; }

    .color-btns { display: flex; gap: 15px; justify-content: center; }
    .btn-color-red { background: linear-gradient(135deg, #be123c, #f43f5e); color: #fff; box-shadow: 0 4px 15px rgba(244, 63, 94, 0.3); }
    .btn-color-black { background: linear-gradient(135deg, #120720, #2A1E3F); color: #fff; box-shadow: 0 4px 15px rgba(0,0,0,0.5); }
    .btn-color:hover:not(:disabled) { transform: translateY(-3px) scale(1.02); filter: brightness(1.2); }

    .game-dashboard {
        background: rgba(0, 0, 0, 0.3);
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        padding: 1rem 1.5rem;
        display: flex; justify-content: space-between; align-items: center;
    }
    .game-stat-label { font-size: 0.6rem; text-transform: uppercase; letter-spacing: 1px; color: #a89cc2; margin-bottom: 2px; }
    .game-stat-value { font-weight: 800; font-size: 1.1rem; }

    .multiplier-badge {
        display: inline-block; padding: 4px 12px; border-radius: 50px;
        background: rgba(245, 197, 66, 0.1); color: #F5C542;
        border: 1px solid rgba(245, 197, 66, 0.3);
        font-size: 0.7rem; font-weight: 900; letter-spacing: 1px;
        animation: pulse-gold 2s infinite;
    }
    @keyframes pulse-gold {
        0%, 100% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.05); opacity: 0.8; }
    }

    /* =============================================
       LIGHT MODE — Rewards Override
       ============================================= */
    [data-theme="light"] body {
        background: radial-gradient(circle at top right, #F3ECFF, #ede4fb) !important;
    }

    [data-theme="light"] .premium-card {
        background: rgba(255, 255, 255, 0.92);
        border: 1px solid rgba(91, 33, 182, 0.12);
        box-shadow: 0 8px 30px rgba(91, 33, 182, 0.08);
        backdrop-filter: blur(10px);
    }
    [data-theme="light"] .premium-card:hover {
        border-color: rgba(91, 33, 182, 0.25);
        box-shadow: 0 12px 40px rgba(91, 33, 182, 0.12);
    }

    [data-theme="light"] .card-header-accent {
        background: linear-gradient(to right, rgba(91, 33, 182, 0.04), transparent);
        border-bottom: 1px solid rgba(91, 33, 182, 0.08);
    }

    [data-theme="light"] .card-title {
        color: #1a0e2e;
    }

    [data-theme="light"] .card-body-content {
        color: #1a0e2e;
    }

    [data-theme="light"] .card-body-content .text-muted {
        color: #6b5b8a !important;
    }

    [data-theme="light"] .balance-pill {
        background: rgba(255, 255, 255, 0.95);
        border: 1px solid rgba(91, 33, 182, 0.15);
        box-shadow: 0 4px 20px rgba(91, 33, 182, 0.1);
    }
    [data-theme="light"] .balance-pill:hover {
        border-color: var(--accent-gold);
    }
    [data-theme="light"] .balance-pill .credits-text {
        color: #1a0e2e;
    }

    [data-theme="light"] .node-circle {
        background: #ede4fb;
        color: #6b5b8a;
        border-color: rgba(91, 33, 182, 0.1);
    }
    [data-theme="light"] .node-circle.active {
        background: #5B21B6;
        color: #fff;
        box-shadow: 0 0 15px rgba(91, 33, 182, 0.4);
        border-color: #5B21B6;
    }
    [data-theme="light"] .node-circle.done {
        background: var(--accent-success);
        color: #fff;
    }

    [data-theme="light"] .streak-line {
        background: rgba(91, 33, 182, 0.08);
    }

    [data-theme="light"] .action-btn:disabled {
        background: #e2d9f3 !important;
        color: #9b8cb8 !important;
    }

    [data-theme="light"] .bet-option {
        background: rgba(91, 33, 182, 0.06);
        border: 1px solid rgba(91, 33, 182, 0.12);
        color: #1a0e2e;
    }
    [data-theme="light"] .bet-option.active {
        background: var(--accent-gold);
        border-color: var(--accent-gold);
        color: #120720;
    }

    [data-theme="light"] .game-dashboard {
        background: rgba(91, 33, 182, 0.04);
        border-bottom: 1px solid rgba(91, 33, 182, 0.08);
    }
    [data-theme="light"] .game-stat-label {
        color: #6b5b8a;
    }
    [data-theme="light"] .game-stat-value {
        color: #1a0e2e;
    }

    [data-theme="light"] .gamble-front {
        background: linear-gradient(135deg, #ede4fb, #d8ccf0) !important;
        color: rgba(91, 33, 182, 0.2) !important;
    }

    [data-theme="light"] .face-front {
        background: linear-gradient(145deg, #ede4fb, #d8ccf0) !important;
        color: rgba(91, 33, 182, 0.15) !important;
        border-color: rgba(91, 33, 182, 0.15);
    }

    [data-theme="light"] .face-back {
        background: linear-gradient(145deg, #fff, #F3ECFF) !important;
    }

    [data-theme="light"] .btn-color-black {
        background: linear-gradient(135deg, #1a0e2e, #2A1E3F) !important;
    }

    [data-theme="light"] .status-badge.badge-free {
        background: rgba(16, 185, 129, 0.1);
    }
    [data-theme="light"] .status-badge.badge-cost {
        background: rgba(217, 70, 239, 0.1);
    }

    [data-theme="light"] .rewards-hero h1 {
        color: #1a0e2e !important;
        -webkit-text-fill-color: #1a0e2e !important;
    }
    [data-theme="light"] .rewards-hero p {
        color: #6b5b8a !important;
    }

    [data-theme="light"] #wheel {
        border-color: #ede4fb;
    }

    [data-theme="light"] .multiplier-badge {
        background: rgba(245, 197, 66, 0.15);
        border-color: rgba(245, 197, 66, 0.3);
        color: #b8860b;
    }

    [data-theme="light"] .hero-icon-box {
        box-shadow: 0 10px 30px rgba(91, 33, 182, 0.2);
    }

    /* --- ALL WHITE TEXT FIXES --- */
    [data-theme="light"] .game-stat-value.text-white,
    [data-theme="light"] .game-stat-value {
        color: #1a0e2e !important;
    }
    [data-theme="light"] .game-stat-value.text-warning,
    [data-theme="light"] #gamePoolDisplay {
        color: #b8860b !important;
    }

    [data-theme="light"] .text-white {
        color: #1a0e2e !important;
    }

    [data-theme="light"] .gamble-front {
        color: rgba(91, 33, 182, 0.25) !important;
    }

    [data-theme="light"] .streak-node small {
        color: #6b5b8a !important;
    }

    [data-theme="light"] .action-btn {
        color: #fff !important;
    }

    [data-theme="light"] .btn-color-red,
    [data-theme="light"] .btn-color-black {
        padding: 10px 30px;
        border-radius: 12px;
        font-weight: 700;
        border: none;
    }

    [data-theme="light"] .card-body-content p,
    [data-theme="light"] .card-body-content small {
        color: #6b5b8a;
    }

    [data-theme="light"] #gambleSetup p {
        color: #6b5b8a !important;
    }

    [data-theme="light"] #gamblePostRound p {
        color: #1a0e2e !important;
    }
    [data-theme="light"] #gamblePostRound small {
        color: #6b5b8a !important;
    }

    [data-theme="light"] .gradient-card,
    [data-theme="light"] .gradient-card * {
        color: #fff !important;
    }

    [data-theme="light"] .fw-black,
    [data-theme="light"] .display-6 {
        color: #1a0e2e !important;
        -webkit-text-fill-color: #1a0e2e !important;
    }

    [data-theme="light"] .game-user-balance {
        color: #1a0e2e !important;
    }

    [data-theme="light"] .fs-6.opacity-50 {
        color: #6b5b8a !important;
    }

    [data-theme="light"] #currentMultiplier {
        color: #b8860b !important;
    }

    [data-theme="light"] #nextWinningsText {
        color: #fff !important;
    }
</style>

<div class="container py-4">
    <!-- BALANACE PILL AREA -->
    <div class="d-flex justify-content-end mb-4">
        <div class="balance-pill">
            <div class="star-icon">
                <i class="bi bi-star-fill text-dark" style="font-size: 0.8rem;"></i>
            </div>
            <div class="credits-text">
                <span id="userCreditsDisplay"><%= user.credits %></span> <small>SP</small>
            </div>
            <a href="javascript:void(0)" onclick="showBuyInfo()" class="plus-btn">
                Gana SP
            </a>
        </div>
    </div>

    <!-- HERO HEADER -->
    <header class="rewards-hero mb-2">
        <div class="hero-icon-box">
            <i class="bi bi-gift-fill text-white fs-3"></i>
        </div>
        <h1 class="fw-black text-white display-6 mb-1">Zona Rewards</h1>
        <p class="text-muted lead fs-6">Participa en juegos diarios y multiplica tus créditos.</p>
    </header>

    <div class="row">
        <!-- RACHA DIARIA -->
        <div class="col-12">
            <div class="premium-card">
                <div class="card-header-accent" style="border-left: 5px solid var(--accent-success);">
                    <h3 class="card-title">
                        <i class="bi bi-lightning-charge-fill" style="color: var(--accent-gold);"></i>
                        Racha de Asistencia
                    </h3>
                    <span class="status-badge badge-free">Premios Diarios</span>
                </div>
                <div class="card-body-content">
                    <div class="streak-container mb-2">
                        <div class="streak-line">
                            <% const progressPercent = ((((user.streakDays - 1) % 7) + 1) / 7) * 100; %>
                            <div class="streak-progress" style="width: <%= progressPercent %>%;"></div>
                        </div>
                        <div class="streak-dots">
                            <% for(let i=1; i<=7; i++) { %>
                                <% const isCurrent = i === (((user.streakDays - 1) % 7) + 1); %>
                                <% const isPast = i < (((user.streakDays - 1) % 7) + 1); %>
                                <div class="streak-node">
                                    <div class="node-circle <%= isCurrent ? 'active' : (isPast ? 'done' : '') %>">
                                        <%= isPast ? '✓' : i %>
                                    </div>
                                    <small class="fw-bold text-muted" style="font-size: 0.6rem;">+5 SP</small>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- COFRE DIARIO -->
        <div class="col-md-6">
            <div class="premium-card h-100">
                <div class="card-header-accent">
                    <h3 class="card-title"><i class="bi bi-box2-heart-fill text-warning"></i> Cofre Místico</h3>
                    <span class="status-badge badge-free">Gratis</span>
                </div>
                <div class="card-body-content">
                    <div class="py-3">
                        <img src="/images/chest_gold.png" class="floating-img mb-4" style="width: 150px;" alt="Cofre">
                    </div>
                    <% if (canOpenChest) { %>
                        <button class="action-btn btn-gold" id="chestBtn" onclick="openChest()">
                            <i class="bi bi-unlock-fill"></i> Abrir Ahora
                        </button>
                    <% } else { %>
                        <button class="action-btn" id="chestBtn" disabled>
                            <i class="bi bi-lock-fill"></i> Usado Hoy
                        </button>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- CAJA DE LA SUERTE -->
        <div class="col-md-6">
            <div class="premium-card h-100">
                <div class="card-header-accent">
                    <h3 class="card-title"><i class="bi bi-box-seam-fill text-info"></i> Caja de Suerte</h3>
                    <span class="status-badge badge-cost">5 SP</span>
                </div>
                <div class="card-body-content">
                    <div class="py-3">
                        <img src="/images/mystery_box.png" class="floating-img mb-4" style="width: 150px;" alt="Caja">
                    </div>
                    <button class="action-btn btn-blue" onclick="openBox()">
                        <i class="bi bi-stars"></i> Probar Suerte
                    </button>
                </div>
            </div>
        </div>

        <!-- RULETA DIARIA -->
        <div class="col-12 mt-2">
            <div class="premium-card">
                <div class="card-header-accent" style="border-left: 5px solid var(--accent-primary);">
                    <h3 class="card-title"><i class="bi bi-bullseye" style="color: var(--accent-primary);"></i> Ruleta de Premios</h3>
                    <span class="status-badge badge-free">Giro Diario</span>
                </div>
                <div class="card-body-content">
                    <div class="position-relative d-inline-block mx-auto mb-4" style="width: 250px; height: 250px;">
                        <div id="wheel" class="rounded-circle w-100 h-100 position-relative"
                            style="
                            transition: transform 4s cubic-bezier(0.2, 0.8, 0.2, 1); 
                            background: conic-gradient(#5B21B6 0deg 60deg, #D946EF 60deg 120deg, #F5C542 120deg 180deg, #10b981 180deg 240deg, #7c3aed 240deg 300deg, #f43f5e 300deg 360deg);">
                            <svg viewBox="0 0 250 250" class="position-absolute w-100 h-100" style="top:0;left:0;">
                                <text x="160" y="65" text-anchor="middle" dominant-baseline="central" transform="rotate(30, 160, 65)" fill="white" font-weight="900" font-size="16">+5</text>
                                <text x="195" y="125" text-anchor="middle" dominant-baseline="central" transform="rotate(90, 195, 125)" fill="white" font-weight="900" font-size="14">+10</text>
                                <text x="160" y="185" text-anchor="middle" dominant-baseline="central" transform="rotate(-30, 160, 185)" fill="white" font-weight="900" font-size="14">+20</text>
                                <text x="90" y="185" text-anchor="middle" dominant-baseline="central" transform="rotate(30, 90, 185)" fill="white" font-weight="900" font-size="14">+50</text>
                                <text x="55" y="125" text-anchor="middle" dominant-baseline="central" transform="rotate(-90, 55, 125)" fill="white" font-weight="900" font-size="11">EXTRA</text>
                                <text x="90" y="65" text-anchor="middle" dominant-baseline="central" transform="rotate(-30, 90, 65)" fill="white" font-weight="900" font-size="13">NADA</text>
                            </svg>
                            <div class="position-absolute rounded-circle"
                                style="width: 46px; height: 46px; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 10; border: 4px solid #120720; background: white; box-shadow: 0 0 20px rgba(0,0,0,0.5);">
                            </div>
                        </div>
                        <div class="position-absolute" style="top: -20px; left: 50%; transform: translateX(-50%); z-index: 11;">
                            <i class="bi bi-caret-down-fill text-white fs-2" style="filter: drop-shadow(0 4px 5px rgba(0,0,0,0.5));"></i>
                        </div>
                    </div>
                    <% if (canSpinWheel) { %>
                        <button id="spinBtn" class="action-btn btn-purple" onclick="spin()">
                            <i class="bi bi-play-circle-fill"></i> Girar Ruleta
                        </button>
                    <% } else { %>
                        <button id="spinBtn" class="action-btn" disabled>
                            <i class="bi bi-lock-fill"></i> Usado Hoy
                        </button>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- DOBLE O NADA -->
        <div class="col-12 mt-2">
            <div class="premium-card">
                <div class="card-header-accent" style="border-left: 5px solid #f43f5e;">
                    <h3 class="card-title"><i class="bi bi-suit-heart-fill text-danger"></i> Doble o Nada</h3>
                    <span class="status-badge badge-cost">Riesgo Total</span>
                </div>
                <div class="card-body-content p-0">
                    <!-- Game Dashboard -->
                    <div class="game-dashboard">
                        <div class="text-start">
                            <div class="game-stat-label">Tu Saldo</div>
                            <div class="game-stat-value text-white"><span class="game-user-balance"><%= user.credits %></span> <small class="fs-6 opacity-50">SP</small></div>
                        </div>
                        <div class="text-center" id="multiplierContainer" style="display: none;">
                            <div class="multiplier-badge" id="currentMultiplier">2X MULTIPLIER</div>
                        </div>
                        <div class="text-end">
                            <div class="game-stat-label">Pozo Ganado</div>
                            <div class="game-stat-value text-warning" id="gamePoolDisplay">0 <small class="fs-6 opacity-50">SP</small></div>
                        </div>
                    </div>

                    <div class="p-4">
                        <div id="gambleSetup">
                            <p class="text-muted small mb-3">Escoge tu apuesta inicial y duplica tus créditos.</p>
                            <div class="bet-selector">
                                <div class="bet-option active" onclick="setGambleBet(5, this)">5 SP</div>
                                <div class="bet-option" onclick="setGambleBet(10, this)">10 SP</div>
                                <div class="bet-option" onclick="setGambleBet(20, this)">20 SP</div>
                            </div>
                        </div>

                        <div class="gamble-card" id="gambleCard">
                            <div class="gamble-card-inner">
                                <div class="gamble-card-face gamble-front">?</div>
                                <div class="gamble-card-face gamble-back" id="gambleBack">A♥</div>
                            </div>
                        </div>

                        <div id="gambleActions" class="color-btns">
                            <button class="btn-color btn-color-red" onclick="playGamble('roja')">Rojo</button>
                            <button class="btn-color btn-color-black" onclick="playGamble('negra')">Negro</button>
                        </div>

                        <div id="gamblePostRound" class="d-none">
                            <div class="py-2">
                                <p class="fw-bold text-success mb-0 animate__animated animate__pulse animate__infinite">¡ACERTASTE!</p>
                                <small class="text-muted">¿Qué quieres hacer ahora?</small>
                            </div>
                            <div class="d-flex flex-column gap-2 mt-3">
                                <button class="action-btn btn-purple" onclick="prepareNextGambleRound()">
                                    <i class="bi bi-arrow-up-circle-fill"></i> DUPLICAR (IR POR <span id="nextWinningsText">0</span> SP)
                                </button>
                                <button class="action-btn btn-gold" onclick="collectGambleWinnings()">
                                    <i class="bi bi-cash-stack"></i> COBRAR PREMIO
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ELIGE UNA CARTA -->
        <div class="col-12">
            <div class="premium-card">
                <div class="card-header-accent" style="border-left: 5px solid var(--accent-danger);">
                    <h3 class="card-title"><i class="bi bi-suit-spade-fill text-danger"></i> Duelo de Cartas</h3>
                    <span class="status-badge badge-cost">5 SP</span>
                </div>
                <div class="card-body-content">
                    <p class="text-muted small mb-4">Selecciona una carta maestra y revela tu destino.</p>
                    <div class="d-flex justify-content-center gap-4 mb-5">
                        <% for(let i=1; i<=3; i++) { %>
                            <div class="card-slot" onclick="playPickCard(<%= i %>)">
                                <div class="card-slot-inner" id="card-<%= i %>">
                                    <div class="card-slot-face face-front">?</div>
                                    <div class="card-slot-face face-back" id="card-back-<%= i %>">0</div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                    <button class="action-btn btn-rose" onclick="playPickCard(Math.ceil(Math.random()*3))">
                        <i class="bi bi-suit-club-fill"></i> Selección Aleatoria
                    </button>
                </div>
            </div>
        </div>

        <!-- TIENDA: CANJEAR SP POR TICKETS -->
        <div class="col-12 mt-2">
            <div class="premium-card" style="border: 1px solid rgba(245, 197, 66, 0.25);">
                <div class="card-header-accent" style="border-left: 5px solid var(--accent-gold); background: linear-gradient(to right, rgba(245, 197, 66, 0.08), transparent);">
                    <h3 class="card-title"><i class="bi bi-ticket-perforated-fill" style="color: var(--accent-gold);"></i> Tienda de Tickets</h3>
                    <span class="status-badge" style="background: rgba(245, 197, 66, 0.15); color: var(--accent-gold); border: 1px solid rgba(245, 197, 66, 0.3);">200 SP = 1 Ticket</span>
                </div>
                <div class="card-body-content">
                    <div class="text-center mb-4">
                        <div style="width: 80px; height: 80px; margin: 0 auto 1rem; background: linear-gradient(135deg, rgba(245, 197, 66, 0.15), rgba(217, 70, 239, 0.1)); border-radius: 50%; display: flex; align-items: center; justify-content: center; border: 2px solid rgba(245, 197, 66, 0.2);">
                            <i class="bi bi-arrow-left-right" style="font-size: 2rem; color: var(--accent-gold);"></i>
                        </div>
                        <h5 class="fw-bold mb-1">Intercambia tus créditos</h5>
                        <p class="text-muted small mb-0">Convierte <strong style="color: var(--accent-gold);">200 SP</strong> en un ticket para cualquier sorteo activo.</p>
                    </div>

                    <div class="d-flex align-items-center justify-content-center gap-3 mb-4 flex-wrap">
                        <div class="text-center px-4 py-3" style="background: rgba(245, 197, 66, 0.08); border-radius: 16px; border: 1px solid rgba(245, 197, 66, 0.15); min-width: 120px;">
                            <div style="font-size: 0.6rem; text-transform: uppercase; letter-spacing: 1px; color: var(--accent-gold); margin-bottom: 4px;">Tu Saldo</div>
                            <div class="fw-bold fs-4 game-user-balance"><%= user.credits %> <small class="fs-6 opacity-50">SP</small></div>
                        </div>
                        <i class="bi bi-arrow-right fs-4" style="color: var(--accent-gold);"></i>
                        <div class="text-center px-4 py-3" style="background: rgba(91, 33, 182, 0.08); border-radius: 16px; border: 1px solid rgba(91, 33, 182, 0.15); min-width: 120px;">
                            <div style="font-size: 0.6rem; text-transform: uppercase; letter-spacing: 1px; color: var(--accent-secondary); margin-bottom: 4px;">Recibes</div>
                            <div class="fw-bold fs-4">1 <small class="fs-6 opacity-50">Ticket</small></div>
                        </div>
                    </div>

                    <% if (activeRaffles && activeRaffles.length > 0) { %>
                        <form action="/recompensas/tienda/comprar" method="POST" id="exchangeForm">
                            <div class="mb-4">
                                <label class="form-label text-muted small fw-bold mb-2">Selecciona un sorteo activo:</label>
                                <select name="raffleId" class="form-select form-select-lg" required style="background-color: var(--input-bg) !important; border: 1px solid var(--card-border) !important; color: var(--text-light) !important; border-radius: 14px; padding: 1rem;">
                                    <% activeRaffles.forEach(raffle => { %>
                                        <option value="<%= raffle._id %>"><%= raffle.title %> — Premio: S/<%= raffle.prizeValue %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <button type="submit" class="action-btn btn-gold" <%= user.credits < 200 ? 'disabled' : '' %>>
                                <i class="bi bi-ticket-perforated-fill"></i>
                                <%= user.credits >= 200 ? 'Canjear 200 SP por 1 Ticket' : `Necesitas ${200 - user.credits} SP más` %>
                            </button>
                        </form>
                    <% } else { %>
                        <div class="text-center py-3">
                            <i class="bi bi-clock-history fs-1 text-muted d-block mb-2"></i>
                            <p class="text-muted small">No hay sorteos activos para canjear. ¡Vuelve pronto!</p>
                        </div>
                    <% } %>

                    <div class="text-center mt-3">
                        <small class="text-muted" style="font-size: 0.7rem;"><i class="bi bi-info-circle me-1"></i> El ticket se asigna automáticamente al sorteo seleccionado.</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

<script>
    function showMessage(title, text, icon = 'success') {
        return Swal.fire({
            title, text, icon,
            confirmButtonText: 'ENTENDIDO',
            background: '#120720',
            color: '#FFF7E6',
            confirmButtonColor: '#F5C542',
            padding: '2rem',
            customClass: {
                popup: 'rounded-4 border border-secondary shadow-lg'
            }
        });
    }

    async function showBuyInfo() {
        const result = await Swal.fire({
            title: '¿Quieres más SP?',
            html: `
                <div class="text-center py-2">
                    <p class="mb-3 fs-5">¡Multiplica tus posibilidades!</p>
                    <p class="text-muted">Al comprar <b>más de 2 tickets</b> para nuestros sorteos, recibirás <b>bonificaciones especiales</b> de créditos SP al instante.</p>
                    <div class="p-3 rounded-4 mt-3" style="background: rgba(91, 33, 182, 0.1); border: 1px dashed rgba(91, 33, 182, 0.3);">
                         <span class="text-white small">🎁 ¡Ideal para seguir jugando sin límites!</span>
                    </div>
                </div>
            `,
            icon: 'info',
            showCancelButton: true,
            confirmButtonText: 'IR A COMPRAR',
            cancelButtonText: 'LUEGO',
            confirmButtonColor: '#F5C542',
            cancelButtonColor: '#2A1E3F',
            background: '#120720',
            color: '#fff'
        });
        if (result.isConfirmed) window.location.href = '/sorteos';
    }

    // GAME LOGIC
    let spinCount = 0;
    async function spin() {
        const wheel = document.getElementById('wheel');
        const btn = document.getElementById('spinBtn');
        const creditsDisplay = document.getElementById('userCreditsDisplay');
        try {
            btn.disabled = true;
            btn.innerHTML = '<i class="bi bi-arrow-repeat spin"></i> Girando...';

            // Reset wheel instantly (no transition) to allow re-spin
            wheel.style.transition = 'none';
            wheel.style.transform = 'rotate(0deg)';
            // Force reflow so the reset takes effect
            wheel.offsetHeight;
            // Re-enable transition for the actual spin
            wheel.style.transition = 'transform 4s cubic-bezier(0.2, 0.8, 0.2, 1)';

            const response = await fetch('/recompensas/ruleta/girar', { method: 'POST' });
            const data = await response.json();
            if (!response.ok) {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-play-circle-fill"></i> Girar Ruleta';
                return showMessage('¡Ops!', data.error, 'error');
            }

            const labelMap = { '+5 SP': 30, '+10 SP': 90, '+20 SP': 150, '+50 SP': 210, 'EXTRA': 270, 'NADA': 330 };
            const targetDeg = labelMap[data.label] || 330;
            spinCount++;
            // 5-8 full rotations + target position (unique each time)
            const extraRotations = (5 + spinCount) * 360;
            const finalAngle = extraRotations + (360 - targetDeg);
            wheel.style.transform = `rotate(${finalAngle}deg)`;

            setTimeout(() => {
                if (creditsDisplay) creditsDisplay.textContent = data.newBalance;
                if (data.prize > 0) confetti({ particleCount: 150, spread: 100, origin: { y: 0.6 } });
                showMessage('Resultado', `Has ganado: ${data.label}`);
                if (data.gotExtraSpin) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-arrow-repeat"></i> ¡GIRO EXTRA!';
                } else {
                    btn.innerHTML = '<i class="bi bi-lock-fill"></i> Usado Hoy';
                }
            }, 4200);
        } catch (err) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-play-circle-fill"></i> Girar Ruleta'; }
    }

    async function openChest() {
        const btn = document.getElementById('chestBtn');
        const creditsDisplay = document.getElementById('userCreditsDisplay');
        try {
            const response = await fetch('/recompensas/cofre/abrir', { method: 'POST' });
            const data = await response.json();
            if (!response.ok) return showMessage('Aviso', data.error, 'info');
            confetti({ particleCount: 100, spread: 70 });
            if (creditsDisplay) creditsDisplay.textContent = data.newBalance;
            btn.disabled = true;
            btn.innerHTML = '<i class="bi bi-lock-fill"></i> Usado Hoy';
            showMessage('¡Éxito!', `Has recibido +${data.prize} SP`);
        } catch (err) { }
    }

    async function openBox() {
        const creditsDisplay = document.getElementById('userCreditsDisplay');
        try {
            const response = await fetch('/recompensas/caja/abrir', { method: 'POST' });
            const data = await response.json();
            if (!response.ok) return showMessage('Aviso', data.error, 'warning');
            if (creditsDisplay) creditsDisplay.textContent = data.newBalance;
            confetti({ particleCount: 100, spread: 70 });
            showMessage('¡Éxito!', `Ganaste +${data.prize} SP`);
        } catch (err) { }
    }

    let cardBusy = false;
    async function playPickCard(num) {
        if (cardBusy) return;
        const card = document.getElementById(`card-${num}`);
        const cardBack = document.getElementById(`card-back-${num}`);
        const creditsDisplay = document.getElementById('userCreditsDisplay');
        try {
            cardBusy = true;
            const response = await fetch('/recompensas/carta/elegir', { method: 'POST' });
            const data = await response.json();
            if (!response.ok) { cardBusy = false; return showMessage('Aviso', data.error, 'warning'); }
            cardBack.textContent = `+${data.prize}`;
            card.parentElement.classList.add('flipped');
            if (creditsDisplay) creditsDisplay.textContent = data.newBalance;
            setTimeout(() => {
                if (data.prize > 0) confetti({ particleCount: 80, spread: 60 });
                showMessage('¡Carta Revelada!', `Premio: +${data.prize} SP`);
                setTimeout(() => { card.parentElement.classList.remove('flipped'); cardBusy = false; }, 2000);
            }, 800);
        } catch (err) { cardBusy = false; }
    }

    // --- DOBLE O NADA LOGIC ---
    let currentGambleBet = 5;
    let currentGambleWinnings = 0;
    let isGambleInitial = true;
    let gambleBusy = false;
    let gambleMultiplier = 1;

    function setGambleBet(amount, el) {
        if (!isGambleInitial) return;
        currentGambleBet = amount;
        document.querySelectorAll('.bet-option').forEach(opt => opt.classList.remove('active'));
        el.classList.add('active');
    }

    function updateGameBalance(newBalance) {
        document.querySelectorAll('.game-user-balance').forEach(el => el.textContent = newBalance);
        const mainBal = document.getElementById('userCreditsDisplay');
        if (mainBal) mainBal.textContent = newBalance;
    }

    async function playGamble(choice) {
        if (gambleBusy) return;
        const gambleCard = document.getElementById('gambleCard');
        const gambleBack = document.getElementById('gambleBack');
        
        try {
            gambleBusy = true;
            const betToUse = isGambleInitial ? currentGambleBet : currentGambleWinnings;
            
            const response = await fetch('/recompensas/doble-o-nada/jugar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ bet: betToUse, choice, isInitial: isGambleInitial })
            });
            const data = await response.json();
            
            if (!response.ok) {
                gambleBusy = false;
                return showMessage('Aviso', data.error, 'warning');
            }

            if (isGambleInitial) {
                updateGameBalance(data.newBalance);
            }

            gambleBack.textContent = data.resultCard;
            gambleBack.className = `gamble-card-face gamble-back ${data.resultColor}`;
            gambleCard.classList.add('flipped');
            
            setTimeout(() => {
                if (data.win) {
                    currentGambleWinnings = data.winnings;
                    gambleMultiplier *= 2;
                    isGambleInitial = false;
                    
                    document.getElementById('gamePoolDisplay').textContent = `${currentGambleWinnings} SP`;
                    document.getElementById('multiplierContainer').style.display = 'block';
                    document.getElementById('currentMultiplier').textContent = `${gambleMultiplier}X MULTIPLIER`;
                    document.getElementById('nextWinningsText').textContent = currentGambleWinnings * 2;
                    
                    confetti({ particleCount: 100, spread: 70, origin: { y: 0.8 } });
                    
                    document.getElementById('gambleSetup').classList.add('d-none');
                    document.getElementById('gambleActions').classList.add('d-none');
                    document.getElementById('gamblePostRound').classList.remove('d-none');
                    
                    showMessage('¡ACERTASTE!', `¡Duplicado! Ahora tienes ${currentGambleWinnings} SP en el pozo.`);
                } else {
                    showMessage('Perdiste', 'La carta te ha traicionado. ¡Suerte la próxima!', 'error');
                    resetGambleUI();
                }
                gambleBusy = false;
            }, 1000);
        } catch (err) { gambleBusy = false; }
    }

    function prepareNextGambleRound() {
        document.getElementById('gambleCard').classList.remove('flipped');
        document.getElementById('gambleActions').classList.remove('d-none');
        document.getElementById('gamblePostRound').classList.add('d-none');
    }

    async function collectGambleWinnings() {
        try {
            const response = await fetch('/recompensas/doble-o-nada/cobrar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ amount: currentGambleWinnings })
            });
            const data = await response.json();
            updateGameBalance(data.newBalance);
            
            showMessage('Premio Cobrado', `¡Excelente! Sumaste ${currentGambleWinnings} SP a tu balance real.`);
            resetGambleUI();
        } catch (err) { }
    }

    function resetGambleUI() {
        currentGambleWinnings = 0;
        gambleMultiplier = 1;
        isGambleInitial = true;
        document.getElementById('gamePoolDisplay').textContent = `0 SP`;
        document.getElementById('multiplierContainer').style.display = 'none';
        document.getElementById('gambleCard').classList.remove('flipped');
        document.getElementById('gambleSetup').classList.remove('d-none');
        document.getElementById('gambleActions').classList.remove('d-none');
        document.getElementById('gamblePostRound').classList.add('d-none');
    }
</script>

<%- include('partials/footer') %>