<%- include('partials/header') %>

<div class="container py-5" style="min-height: 70vh;">
  <div class="text-center mb-5">
    <span class="badge bg-primary px-3 py-2 fs-6 mb-3 rounded-pill shadow-sm">
      <i class="bi bi-star-fill text-warning me-1"></i> Alianzas Estratégicas
    </span>
    <h1 class="display-5 fw-bold mb-3">Negocios Aliados</h1>
    <p class="lead text-muted mx-auto" style="max-width: 600px;">
      Nuestros socios comerciales te regalan tickets para los sorteos. Visítalos, realiza tus compras según la promoción y reclama tu ticket gratis.
    </p>
  </div>

  <div class="row g-4 justify-content-center">
    <% if (businesses && businesses.length > 0) { %>
      <% businesses.forEach(biz => { %>
        <div class="col-md-6 col-lg-4">
          <div class="card border-0 shadow-sm h-100 hover-lift transition-all" style="border-radius: 1rem; overflow: hidden;">
            <div class="card-header bg-dark text-white text-center py-3 border-0">
              <i class="bi bi-shop fs-1 mb-2 d-block text-warning"></i>
              <h4 class="fw-bold mb-0"><%= biz.name %></h4>
            </div>
            <div class="card-body p-4 text-center d-flex flex-column">
              <h6 class="text-primary fw-bold text-uppercase tracking-wide mb-3">Promoción Activa</h6>
              <p class="fs-5 fw-semibold flex-grow-1" style="color: var(--text-light);">
                "<%= biz.promoDescription || 'Acércate al local y consulta por nuestros códigos de regalo' %>"
              </p>
              <hr class="text-muted opacity-25">
              <a href="/canjear" class="btn btn-outline-success w-100 mt-auto rounded-pill fw-bold">
                <i class="bi bi-ticket-detailed me-2"></i> Canjear ticket de <%= biz.name %>
              </a>
            </div>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="col-12 text-center py-5">
        <i class="bi bi-shop-window text-muted" style="font-size: 5rem;"></i>
        <h3 class="fw-bold mt-3">Próximamente</h3>
        <p class="text-muted">Estamos sumando nuevos negocios aliados para regalarte más oportunidades de ganar.</p>
      </div>
    <% } %>
  </div>

  <div class="text-center mt-5 pt-4">
    <div class="p-4 rounded-4 d-inline-block shadow-sm" style="background: var(--card-bg); border: 1px solid var(--card-border);">
      <h5 class="fw-bold mb-3">¿Ya tienes un código?</h5>
      <a href="/canjear" class="btn btn-primary btn-lg px-5 fw-bold rounded-pill">
        Canjear Mi Código <i class="bi bi-arrow-right ms-2"></i>
      </a>
    </div>
  </div>
</div>

<style>
.hover-lift {
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.hover-lift:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 25px rgba(0,0,0,0.1) !important;
}
.tracking-wide {
  letter-spacing: 0.05em;
}
</style>

<%- include('partials/footer') %>
