<%- include('partials/header') %>

<style>
  .gradient-card {
    background: linear-gradient(135deg, #7e22ce, #db2777);
    border-radius: 1.5rem;
    color: white;
    position: relative;
    overflow: hidden;
  }
  .gradient-card::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -30%;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background: rgba(255,255,255,0.08);
  }
  .next-raffle-card {
    border-left: 5px solid #9333ea;
    animation: glow-border 2s ease-in-out infinite alternate;
  }
  @keyframes glow-border {
    from { border-left-color: #9333ea; }
    to { border-left-color: #ec4899; }
  }
  .history-ticket {
    transition: all 0.3s ease;
  }
  .history-ticket:hover {
    background: #faf5ff !important;
  }
</style>

<div class="container py-4">
  
  <!-- HEADER con saludo -->
  <div class="gradient-card p-4 p-md-5 mb-4">
    <div class="d-flex align-items-center">
      <div class="rounded-circle d-inline-flex align-items-center justify-content-center me-3 flex-shrink-0" style="width: 65px; height: 65px; font-size: 1.8rem; background: rgba(255,255,255,0.2); backdrop-filter: blur(5px);">
        <%= user.name.charAt(0).toUpperCase() %>
      </div>
      <div>
        <h3 class="fw-bold mb-0">¡Hola, <%= user.name.split(' ')[0] %>!</h3>
        <p class="mb-0 opacity-75">Bienvenido a tu panel de SorteosPeru.pe</p>
      </div>
    </div>
  </div>

  <!-- NOTIFICACIÓN DE GANADOR -->
  <% if (wins && wins.length > 0) { %>
    <% wins.forEach(win => { %>
      <div class="card border-0 shadow mb-4 overflow-hidden" style="border-left: 6px solid #f59e0b !important;">
        <div class="card-body p-4">
          <div class="d-flex align-items-center">
            <div class="me-3" style="font-size: 3.5rem;">🏆</div>
            <div>
              <h4 class="fw-bold mb-1" style="color: #f59e0b;">¡Felicidades, ganaste!</h4>
              <p class="mb-1">Ganaste <strong class="text-success fs-5">S/<%= win.prizeValue %></strong> en el sorteo "<%= win.raffleId ? win.raffleId.title : 'Sorteo' %>"</p>
              <% if (win.deliveryStatus === 'delivered') { %>
                <span class="badge bg-success px-3 py-2"><i class="bi bi-check-circle-fill me-1"></i> Premio Entregado</span>
              <% } else { %>
                <span class="badge bg-warning text-dark px-3 py-2"><i class="bi bi-clock-fill me-1"></i> Premio pendiente de entrega — te contactaremos pronto</span>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    <% }) %>
  <% } %>

  <div class="row g-4">
    <!-- COLUMNA IZQUIERDA -->
    <div class="col-md-8">

      <!-- SORTEOS COMPLETADOS: Resultado del último sorteo -->
      <% 
        const completedTickets = tickets.filter(t => t.raffleId && t.raffleId.status === 'completed');
        const activeTickets = tickets.filter(t => t.raffleId && t.raffleId.status === 'active');
        const myWinIds = wins ? wins.map(w => w.raffleId ? w.raffleId._id.toString() : '') : [];
      %>

      <% if (completedTickets.length > 0) { %>
        <div class="mb-4">
          <h5 class="fw-bold text-muted mb-3"><i class="bi bi-flag-fill me-2"></i>Sorteos Finalizados</h5>
          <% completedTickets.forEach(ticket => { %>
            <div class="card border-0 shadow-sm mb-3">
              <div class="card-body p-4">
                <% const isWinner = myWinIds.includes(ticket.raffleId._id.toString()); %>
                <% if (isWinner) { %>
                  <div class="d-flex align-items-center">
                    <div class="me-3" style="font-size: 2.5rem;">🎉</div>
                    <div>
                      <span class="badge bg-warning text-dark mb-1">¡GANADOR!</span>
                      <h5 class="fw-bold mb-1"><%= ticket.raffleId.title %></h5>
                      <p class="text-muted small mb-0">Tu ticket <strong><%= ticket.ticketNumber %></strong> fue el ganador. ¡Felicidades!</p>
                    </div>
                  </div>
                <% } else { %>
                  <div class="d-flex align-items-center">
                    <div class="me-3" style="font-size: 2rem;">📋</div>
                    <div>
                      <span class="badge bg-secondary mb-1">Finalizado</span>
                      <h5 class="fw-bold mb-1"><%= ticket.raffleId.title %></h5>
                      <p class="text-muted small mb-1">Tu ticket: <strong><%= ticket.ticketNumber %></strong></p>
                      <p class="mb-0 small">No fue tu día esta vez. <strong class="text-primary">¡La próxima puede ser la tuya!</strong> 💪</p>
                    </div>
                  </div>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>

      <!-- TICKETS ACTIVOS (sorteos en curso) -->
      <% if (activeTickets.length > 0) { %>
        <h5 class="fw-bold text-muted mb-3"><i class="bi bi-ticket-perforated-fill me-2"></i>Tus Tickets Activos</h5>
        <div class="row g-3 mb-4">
          <% activeTickets.forEach(ticket => { %>
            <div class="col-md-6">
              <div class="card border-0 shadow-sm h-100" style="border-top: 4px solid #22c55e !important;">
                <div class="card-body text-center p-4">
                  <span class="badge bg-success mb-2"><i class="bi bi-check-circle-fill me-1"></i> En juego</span>
                  <p class="text-muted small mb-1">Número de Ticket</p>
                  <h3 class="ticket-number mb-3"><%= ticket.ticketNumber %></h3>
                  <p class="small mb-1"><strong>Sorteo:</strong> <%= ticket.raffleId.title %></p>
                  <p class="small mb-0"><strong>Premio:</strong> S/<%= ticket.raffleId.prizeValue %></p>
                  <% if (ticket.raffleId.drawDate) { %>
                    <p class="small text-primary mt-2 mb-0">
                      <i class="bi bi-clock"></i> 
                      <%= ticket.raffleId.drawDate.toLocaleDateString('es-PE', {day:'2-digit', month:'short'}) %> - 
                      <%= ticket.raffleId.drawDate.toLocaleTimeString('es-PE', {hour:'2-digit', minute:'2-digit', hour12:true}) %>
                    </p>
                  <% } %>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>

      <!-- PAGOS PENDIENTES -->
      <% const pendingPayments = payments.filter(p => p.status === 'pending'); %>
      <% if (pendingPayments.length > 0) { %>
        <h5 class="fw-bold text-muted mb-3"><i class="bi bi-hourglass-split me-2"></i>Pagos en Validación</h5>
        <% pendingPayments.forEach(payment => { %>
          <div class="card border-0 shadow-sm mb-3" style="border-left: 4px solid #eab308 !important;">
            <div class="card-body p-3 d-flex align-items-center">
              <i class="bi bi-clock-fill text-warning fs-3 me-3"></i>
              <div>
                <p class="fw-bold mb-0"><%= payment.raffleId ? payment.raffleId.title : 'Sorteo' %></p>
                <p class="text-muted small mb-0">Tu comprobante está siendo revisado. Te notificaremos por WhatsApp.</p>
              </div>
            </div>
          </div>
        <% }) %>
      <% } %>

      <!-- PAGOS RECHAZADOS -->
      <% const rejectedPayments = payments.filter(p => p.status === 'rejected'); %>
      <% if (rejectedPayments.length > 0) { %>
        <% rejectedPayments.forEach(payment => { %>
          <div class="card border-0 shadow-sm mb-3" style="border-left: 4px solid #ef4444 !important;">
            <div class="card-body p-3 d-flex align-items-center">
              <i class="bi bi-x-circle-fill text-danger fs-3 me-3"></i>
              <div>
                <p class="fw-bold mb-0"><%= payment.raffleId ? payment.raffleId.title : 'Sorteo' %></p>
                <p class="text-danger small mb-0">Rechazado: <%= payment.rejectionReason || 'Comprobante inválido' %></p>
              </div>
            </div>
          </div>
        <% }) %>
      <% } %>

      <!-- SI NO TIENE NADA -->
      <% if (tickets.length === 0 && pendingPayments.length === 0) { %>
        <div class="card border-0 shadow-sm p-5 text-center">
          <i class="bi bi-emoji-smile text-primary" style="font-size: 4rem;"></i>
          <h4 class="fw-bold mt-3">¡Aún no participas!</h4>
          <p class="text-muted">Compra tu primer ticket y empieza a ganar.</p>
          <a href="/sorteos" class="btn btn-primary btn-lg px-5">Ver Sorteos</a>
        </div>
      <% } %>
    </div>

    <!-- COLUMNA DERECHA -->
    <div class="col-md-4">
      
      <!-- PRÓXIMO SORTEO -->
      <% if (nextRaffle) { %>
        <div class="card border-0 shadow-sm next-raffle-card mb-4">
          <div class="card-body p-4">
            <p class="text-muted small fw-bold mb-2"><i class="bi bi-lightning-charge-fill text-warning"></i> PRÓXIMO SORTEO</p>
            <h5 class="fw-bold mb-2"><%= nextRaffle.title %></h5>
            <h4 class="fw-bold text-success mb-2">S/<%= nextRaffle.prizeValue %></h4>
            <% if (nextRaffle.drawDate) { %>
              <p class="small mb-3">
                <i class="bi bi-calendar-event text-primary"></i>
                <%= nextRaffle.drawDate.toLocaleDateString('es-PE', {weekday:'short', day:'2-digit', month:'short'}) %> - 
                <%= nextRaffle.drawDate.toLocaleTimeString('es-PE', {hour:'2-digit', minute:'2-digit', hour12:true}) %>
              </p>
            <% } %>
            <a href="/sorteos/<%= nextRaffle._id %>" class="btn btn-primary w-100 fw-bold">
              <i class="bi bi-ticket-perforated me-1"></i> ¡No te quedes fuera!
            </a>
          </div>
        </div>
      <% } %>

      <!-- RESUMEN -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h6 class="fw-bold text-muted mb-3"><i class="bi bi-bar-chart-fill me-2"></i>Mi Resumen</h6>
          <div class="d-flex justify-content-between py-2 border-bottom">
            <span class="text-muted">Tickets Comprados</span>
            <strong><%= tickets.length %></strong>
          </div>
          <div class="d-flex justify-content-between py-2 border-bottom">
            <span class="text-muted">Sorteos Ganados</span>
            <strong class="text-success"><%= wins ? wins.length : 0 %></strong>
          </div>
          <div class="d-flex justify-content-between py-2 border-bottom">
            <span class="text-muted">En Juego</span>
            <strong class="text-primary"><%= activeTickets.length %></strong>
          </div>
          <div class="d-flex justify-content-between py-2">
            <span class="text-muted">Pagos Pendientes</span>
            <strong class="text-warning"><%= pendingPayments.length %></strong>
          </div>
        </div>
      </div>

      <!-- CTA MOTIVACIONAL -->
      <div class="card border-0 shadow-sm overflow-hidden">
        <div class="card-body p-4 text-center" style="background: linear-gradient(135deg, #faf5ff, #fdf2f8);">
          <div style="font-size: 2.5rem;">🍀</div>
          <h6 class="fw-bold mt-2">¿No te quedes con las ganas!</h6>
          <p class="text-muted small mb-3">Mientras más tickets compres, más oportunidades tienes de ganar.</p>
          <a href="/sorteos" class="btn btn-outline-primary btn-sm fw-bold">Ver Sorteos Activos</a>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
