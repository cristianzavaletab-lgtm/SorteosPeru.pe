<%- include('partials/header') %>

<style>
  .gradient-card {
    background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
    border-radius: 1.5rem;
    color: white;
    position: relative;
    overflow: hidden;
  }
  .gradient-card::before {
    content: '';
    position: absolute;
    top: -50%; right: -30%;
    width: 300px; height: 300px;
    border-radius: 50%;
    background: rgba(255,255,255,0.08);
  }
  .section-title {
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    padding-bottom: 0.5rem;
    border-bottom: 3px solid;
    display: inline-block;
    margin-bottom: 1rem;
  }
  .ticket-card {
    transition: all 0.3s ease;
    border-radius: 1rem !important;
  }
  .ticket-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.1) !important;
  }
  .next-raffle-card {
    border-left: 5px solid var(--primary-color);
    animation: glow-border 2s ease-in-out infinite alternate;
    border-radius: 1rem !important;
  }
  @keyframes glow-border {
    from { border-left-color: var(--primary-color); }
    to { border-left-color: var(--secondary-color); }
  }
  .tab-custom .nav-link {
    color: var(--text-muted);
    font-weight: 600;
    border: none;
    border-bottom: 3px solid transparent;
    border-radius: 0;
    padding: 0.75rem 1.25rem;
  }
  .tab-custom .nav-link.active {
    color: var(--accent-color);
    border-bottom-color: var(--accent-color);
    background: none;
  }
  .tab-custom .nav-link:hover { color: var(--accent-color); }
  .stat-card {
    border-radius: 1rem !important;
    border: none !important;
    transition: all 0.3s ease;
  }
  .stat-card:hover { transform: translateY(-3px); }
</style>

<div class="container py-4">
  
  <!-- HEADER -->
  <div class="gradient-card p-4 p-md-5 mb-4">
    <div class="d-flex align-items-center">
      <div class="rounded-circle d-inline-flex align-items-center justify-content-center me-3 flex-shrink-0" style="width: 65px; height: 65px; font-size: 1.8rem; background: rgba(255,255,255,0.2);">
        <%= user.name.charAt(0).toUpperCase() %>
      </div>
      <div>
        <h3 class="fw-bold mb-0">¡Hola, <%= user.name.split(' ')[0] %>!</h3>
        <p class="mb-0 opacity-75">Bienvenido a tu panel de SorteosPeru.pe</p>
      </div>
    </div>
  </div>

  <!-- ALERTAS DE SISTEMA (QUERY) -->
  <% if (locals.query && locals.query.success) { %>
    <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm d-flex align-items-center mb-4" role="alert" style="background: rgba(16, 185, 129, 0.15); border-left: 5px solid #10b981 !important;">
      <i class="bi bi-check-circle-fill fs-3 text-success me-3"></i>
      <div>
        <h6 class="fw-bold text-success mb-0">¡Listo!</h6>
        <span class="text-theme-light"><%= locals.query.success %></span>
      </div>
      <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>
  <% if (locals.query && locals.query.error) { %>
    <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm d-flex align-items-center mb-4" role="alert" style="background: rgba(239, 68, 68, 0.15); border-left: 5px solid #ef4444 !important;">
      <i class="bi bi-exclamation-triangle-fill fs-3 text-danger me-3"></i>
      <div>
        <h6 class="fw-bold text-danger mb-0">Atención</h6>
        <span class="text-theme-light"><%= locals.query.error %></span>
      </div>
      <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <!-- ALERTA SI NO TIENE TELÉFONO -->
  <% if (!user.phone) { %>
    <div class="alert border-0 shadow-sm rounded-4 p-4 mb-4 d-flex align-items-center justify-content-between flex-wrap gap-3" style="background: linear-gradient(135deg, rgba(245, 158, 11, 0.15), rgba(234, 88, 12, 0.1)); border-left: 6px solid #f59e0b !important;">
      <div class="d-flex align-items-center">
        <div class="rounded-circle d-flex align-items-center justify-content-center me-3 flex-shrink-0" style="width: 50px; height: 50px; background: rgba(245, 158, 11, 0.2); font-size: 1.6rem; color: #d97706;">
          <i class="bi bi-whatsapp"></i>
        </div>
        <div>
          <h5 class="fw-bold mb-1" style="color: #b45309;">¡Completa tu WhatsApp para recibir tus tickets y premios!</h5>
          <p class="mb-0 text-muted small">Aún no tienes un número celular registrado en tu cuenta. Es indispensable para enviarte tus tickets aprobados y llamarte en vivo cuando ganes.</p>
        </div>
      </div>
      <a href="#modulo-whatsapp" class="btn btn-warning fw-bold text-dark rounded-pill px-4 py-2 shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> Registrar Celular
      </a>
    </div>
  <% } %>

  <%
    const activeTickets = tickets.filter(t => t.raffleId && t.raffleId.status === 'active');
    const completedTickets = tickets.filter(t => t.raffleId && t.raffleId.status === 'completed');
    
    // Separar premios válidos de anulados/descalificados (por falta de WhatsApp u otro motivo)
    const validWins = (wins || []).filter(w => w.deliveryStatus !== 'disqualified');
    const annulledWins = (wins || []).filter(w => w.deliveryStatus === 'disqualified');

    const myValidWinTicketIds = validWins.map(w => w.ticketId ? (w.ticketId._id ? w.ticketId._id.toString() : w.ticketId.toString()) : '');
    const pendingPayments = payments.filter(p => p.status === 'pending');
    const rejectedPayments = payments.filter(p => p.status === 'rejected');
    const wonTickets = completedTickets.filter(t => myValidWinTicketIds.includes(t._id.toString()));
    const lostTickets = completedTickets.filter(t => !myValidWinTicketIds.includes(t._id.toString()));
  %>

  <!-- ALERTA DE SORTEO ANULADO (SI HUBO DESCALIFICACIÓN POR FALTA DE WHATSAPP) -->
  <% if (annulledWins && annulledWins.length > 0) { %>
    <% annulledWins.forEach(annulled => { %>
      <div class="card border-0 shadow-sm mb-4 ticket-card overflow-hidden" style="border-left: 6px solid #ef4444 !important; background: rgba(239, 68, 68, 0.04);">
        <div class="card-body p-4 d-flex align-items-center justify-content-between flex-wrap gap-3">
          <div class="d-flex align-items-center">
            <div class="me-3 fs-1 text-danger">⚠️</div>
            <div>
              <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                <span class="badge bg-danger px-3 py-1 fw-bold"><i class="bi bi-x-circle me-1"></i>PREMIO ANULADO</span>
                <span class="text-theme-muted small fw-bold"><%= annulled.raffleId ? annulled.raffleId.title : 'Sorteo' %></span>
              </div>
              <h5 class="fw-bold mb-1 text-danger">
                El premio de S/<%= annulled.prizeValue %> no pudo ser entregado
              </h5>
              <p class="mb-2 text-theme-muted small">
                Motivo: <strong class="text-danger"><%= annulled.disqualifiedReason || 'No se pudo contactar por no contar con número de WhatsApp registrado en la cuenta al momento de la llamada en vivo.' %></strong>
              </p>
              <div class="p-2 rounded-3 mb-0" style="background: rgba(16, 185, 129, 0.08); border-left: 4px solid #10b981;">
                <p class="mb-0 small text-theme-light">
                  <i class="bi bi-shield-check text-success me-1"></i>
                  <strong>Tus tickets siguen guardados en tu historial.</strong> Para asegurar que recibas futuros premios, por favor registra o mantén actualizado tu número de WhatsApp.
                </p>
              </div>
            </div>
          </div>
          <div class="d-flex flex-column gap-2 flex-shrink-0">
            <a href="#modulo-whatsapp" class="btn btn-warning fw-bold text-dark rounded-pill px-4 shadow-sm">
              <i class="bi bi-whatsapp me-1"></i> Registrar / Cambiar WhatsApp
            </a>
            <a href="https://wa.me/51918762620?text=<%= encodeURIComponent(`¡Hola SorteosPeru.pe! Mi ticket fue seleccionado pero figuró anulado en el sorteo \"${annulled.raffleId ? annulled.raffleId.title : 'Sorteo'}\". Mi nombre es ${user.name} y mi celular es ${user.phone || 'no registrado'}.`) %>" target="_blank" class="btn btn-outline-secondary rounded-pill btn-sm text-center">
              <i class="bi bi-headset me-1"></i> Soporte Oficial (918 762 620)
            </a>
          </div>
        </div>
      </div>
    <% }) %>
  <% } %>

  <!-- BANNER GANADOR OFICIAL (SOLO PREMIOS VÁLIDOS) -->
  <% if (validWins && validWins.length > 0) { %>
    <% validWins.forEach(win => { %>
      <div class="card border-0 shadow mb-4 ticket-card overflow-hidden" style="border-left: 6px solid #f59e0b !important; background: linear-gradient(135deg, rgba(245, 158, 11, 0.05), rgba(234, 88, 12, 0.02));">
        <div class="card-body p-4 d-flex align-items-center justify-content-between flex-wrap gap-3">
          <div class="d-flex align-items-center">
            <div class="me-3" style="font-size: 3rem;">🏆</div>
            <div>
              <h4 class="fw-bold mb-1" style="color: #f59e0b;">¡Felicidades <%= user.name.split(' ')[0] %>, ganaste!</h4>
              <p class="mb-1">Ganaste <strong class="text-success fs-5">S/<%= win.prizeValue %></strong> en "<%= win.raffleId ? win.raffleId.title : 'Sorteo' %>"</p>
              <div class="d-flex gap-2 align-items-center flex-wrap">
                <% if (win.deliveryStatus === 'delivered') { %>
                  <span class="badge bg-success px-3 py-2"><i class="bi bi-check-circle-fill me-1"></i> Premio Entregado con Éxito</span>
                <% } else { %>
                  <span class="badge bg-warning text-dark px-3 py-2"><i class="bi bi-clock-fill me-1"></i> Pendiente de entrega</span>
                <% } %>
                <% const winTicketNum = win.ticketId ? (win.ticketId.ticketNumber || win.ticketId) : ''; %>
                <% if (winTicketNum) { %>
                  <span class="badge bg-primary px-3 py-2"><i class="bi bi-ticket-perforated me-1"></i> Ticket Ganador: <%= winTicketNum %></span>
                <% } %>
              </div>
            </div>
          </div>
          <div>
            <%
              const winTicketNumStr = win.ticketId ? (win.ticketId.ticketNumber || win.ticketId) : '';
              const claimMsg = encodeURIComponent(
                `¡Hola SorteosPeru.pe! 🏆\n\n` +
                `Soy ${user.name} y acabo de ganar el sorteo "${win.raffleId ? win.raffleId.title : 'Sorteo'}" por el premio de S/${win.prizeValue}.\n` +
                `Mi ticket ganador es: #${winTicketNumStr || 'N/A'}\n` +
                `Mi celular registrado es: ${user.phone || 'No registrado'}\n\n` +
                `Escribo para coordinar la validación y entrega oficial de mi premio al 918 762 620. ¡Muchas gracias!`
              );
            %>
            <a href="https://wa.me/51918762620?text=<%= claimMsg %>" target="_blank" class="btn btn-success btn-lg fw-bold rounded-pill px-4 shadow-sm" style="background-color: #25D366; border-color: #25D366;">
              <i class="bi bi-whatsapp me-2"></i> Coordinar Entrega por WhatsApp
            </a>
          </div>
        </div>
      </div>
    <% }) %>
  <% } %>

  <div class="row g-4">
    <!-- COLUMNA PRINCIPAL -->
    <div class="col-lg-8">

      <!-- PRÓXIMO SORTEO DESTACADO -->
      <% if (nextRaffle) { %>
        <div class="card border-0 shadow-sm next-raffle-card mb-4 overflow-hidden">
          <div class="card-body p-0">
            <div class="row g-0 align-items-center">
              <% if (nextRaffle.image) { %>
                <div class="col-4">
                  <img src="<%= nextRaffle.image %>" class="w-100 h-100" style="object-fit: cover; min-height: 150px;">
                </div>
                <div class="col-8 p-4">
              <% } else { %>
                <div class="col-12 p-4">
              <% } %>
                <div class="d-flex align-items-center mb-2">
                  <span class="badge bg-danger me-2 px-2 py-1" style="animation: pulse-dot 1s infinite alternate;">
                    <i class="bi bi-lightning-charge-fill"></i> NUEVO
                  </span>
                  <small class="text-muted fw-bold">SORTEO ACTIVO</small>
                </div>
                <h4 class="fw-bold mb-1"><%= nextRaffle.title %></h4>
                <h5 class="text-success fw-bold mb-2">Premio: S/<%= nextRaffle.prizeValue %></h5>
                <% if (nextRaffle.drawDate) { %>
                  <p class="small text-muted mb-2">
                    <i class="bi bi-calendar-event"></i>
                    <%= nextRaffle.drawDate.toLocaleDateString('es-PE', {weekday:'short', day:'2-digit', month:'short'}) %> - 
                    <%= nextRaffle.drawDate.toLocaleTimeString('es-PE', {hour:'2-digit', minute:'2-digit', hour12:true}) %>
                  </p>
                <% } %>
                <div class="d-flex gap-2 flex-wrap">
                  <a href="/sorteos/<%= nextRaffle._id %>" class="btn btn-primary fw-bold">
                    <i class="bi bi-ticket-perforated me-1"></i> Participar
                  </a>
                  <a href="/sorteos/<%= nextRaffle._id %>/live" class="btn btn-danger fw-bold" style="animation: pulse 2s infinite;">
                    <i class="bi bi-broadcast me-1"></i> VER EN VIVO
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% } %>

      <!-- TABS DE SECCIONES -->
      <ul class="nav tab-custom mb-3" role="tablist">
        <li class="nav-item">
          <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabActive">
            <i class="bi bi-ticket-perforated-fill me-1"></i> En Juego
            <% if (activeTickets.length > 0) { %><span class="badge bg-primary ms-1"><%= activeTickets.length %></span><% } %>
          </button>
        </li>
        <li class="nav-item">
          <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabWon">
            <i class="bi bi-trophy-fill me-1"></i> Ganados
            <% if (wonTickets.length > 0) { %><span class="badge bg-warning text-dark ms-1"><%= wonTickets.length %></span><% } %>
          </button>
        </li>
        <li class="nav-item">
          <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabHistory">
            <i class="bi bi-clock-history me-1"></i> Historial
            <% if (lostTickets.length > 0) { %><span class="badge bg-secondary ms-1"><%= lostTickets.length %></span><% } %>
          </button>
        </li>
        <li class="nav-item">
          <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabPending">
            <i class="bi bi-hourglass-split me-1"></i> Pendientes
            <% if (pendingPayments.length > 0) { %><span class="badge bg-warning text-dark ms-1"><%= pendingPayments.length %></span><% } %>
          </button>
        </li>
      </ul>

      <div class="tab-content">
        <!-- TAB: EN JUEGO -->
        <div class="tab-pane fade show active" id="tabActive">
          <% if (activeTickets.length > 0) { %>
            <div class="row g-3">
              <% activeTickets.forEach(ticket => { %>
                <div class="col-sm-6">
                  <div class="card border-0 shadow-sm ticket-card h-100" style="border-top: 4px solid #22c55e !important;">
                    <div class="card-body text-center p-4 d-flex flex-column justify-content-between">
                      <div>
                        <span class="badge bg-success mb-2"><i class="bi bi-check-circle-fill me-1"></i> Activo</span>
                        <p class="text-muted small mb-1">Ticket Oficial</p>
                        <h3 class="ticket-number mb-2"><%= ticket.ticketNumber %></h3>
                        <p class="fw-bold mb-1"><%= ticket.raffleId.title %></p>
                        <p class="text-success fw-bold mb-0">Premio: S/<%= ticket.raffleId.prizeValue %></p>
                        <% if (ticket.raffleId.drawDate) { %>
                          <p class="small text-primary mt-2 mb-0">
                            <i class="bi bi-clock"></i> 
                            <%= ticket.raffleId.drawDate.toLocaleDateString('es-PE', {day:'2-digit', month:'short'}) %> - 
                            <%= ticket.raffleId.drawDate.toLocaleTimeString('es-PE', {hour:'2-digit', minute:'2-digit', hour12:true}) %>
                          </p>
                        <% } %>
                      </div>

                      <div class="mt-3 pt-3 border-top">
                        <%
                          const shareMsg = encodeURIComponent(
                            `¡Estoy participando en el sorteo "${ticket.raffleId.title}" de SorteosPeru.pe con mi ticket oficial 🎫 ${ticket.ticketNumber}! Premio: S/${ticket.raffleId.prizeValue}. ¡Deséenme suerte! 🍀`
                          );
                        %>
                        <a href="https://wa.me/?text=<%= shareMsg %>" target="_blank" class="btn btn-sm btn-outline-success rounded-pill w-100 fw-bold" title="Compartir mi ticket en WhatsApp">
                          <i class="bi bi-whatsapp me-1"></i> Compartir Ticket
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <div class="card border-0 shadow-sm p-5 text-center ticket-card">
              <i class="bi bi-ticket-perforated text-muted" style="font-size: 3rem;"></i>
              <h5 class="fw-bold mt-3">Sin tickets activos</h5>
              <p class="text-muted small">Compra un ticket para participar en el próximo sorteo.</p>
              <a href="/sorteos" class="btn btn-primary">Ver Sorteos</a>
            </div>
          <% } %>
        </div>

        <!-- TAB: GANADOS -->
        <div class="tab-pane fade" id="tabWon">
          <% if (wonTickets.length > 0) { %>
            <% wonTickets.forEach(ticket => { %>
              <div class="card border-0 shadow-sm ticket-card mb-3" style="border-left: 5px solid #f59e0b !important;">
                <div class="card-body p-4 d-flex align-items-center">
                  <div class="me-3" style="font-size: 2.5rem;">🎉</div>
                  <div>
                    <span class="badge bg-warning text-dark mb-1">¡GANADOR!</span>
                    <h5 class="fw-bold mb-1"><%= ticket.raffleId.title %></h5>
                    <p class="mb-0 small">Ticket ganador: <strong><%= ticket.ticketNumber %></strong></p>
                    <p class="mb-0 text-success fw-bold">Premio: S/<%= ticket.raffleId.prizeValue %></p>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="card border-0 shadow-sm p-5 text-center ticket-card">
              <i class="bi bi-trophy text-muted" style="font-size: 3rem;"></i>
              <h5 class="fw-bold mt-3">Aún no has ganado</h5>
              <p class="text-muted small">¡Sigue participando, la suerte está de tu lado!</p>
            </div>
          <% } %>
        </div>

        <!-- TAB: HISTORIAL -->
        <div class="tab-pane fade" id="tabHistory">
          <% if (lostTickets.length > 0) { %>
            <% lostTickets.forEach(ticket => { %>
              <div class="card border-0 shadow-sm ticket-card mb-3">
                <div class="card-body p-3 d-flex align-items-center">
                  <div class="me-3" style="font-size: 1.5rem;">📋</div>
                  <div class="flex-grow-1">
                    <div class="d-flex justify-content-between align-items-center">
                      <div>
                        <h6 class="fw-bold mb-0"><%= ticket.raffleId.title %></h6>
                        <p class="text-muted small mb-0">Ticket: <%= ticket.ticketNumber %></p>
                      </div>
                      <span class="badge bg-secondary">No ganador</span>
                    </div>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="card border-0 shadow-sm p-5 text-center ticket-card">
              <i class="bi bi-clock-history text-muted" style="font-size: 3rem;"></i>
              <h5 class="fw-bold mt-3">Sin historial</h5>
              <p class="text-muted small">Tus sorteos pasados aparecerán aquí.</p>
            </div>
          <% } %>
        </div>

        <!-- TAB: PENDIENTES -->
        <div class="tab-pane fade" id="tabPending">
          <% if (pendingPayments.length > 0 || rejectedPayments.length > 0) { %>
            <% pendingPayments.forEach(payment => { %>
              <div class="card border-0 shadow-sm ticket-card mb-3" style="border-left: 4px solid #eab308 !important;">
                <div class="card-body p-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
                  <div class="d-flex align-items-center">
                    <i class="bi bi-clock-fill text-warning fs-3 me-3"></i>
                    <div>
                      <p class="fw-bold mb-0"><%= payment.raffleId ? payment.raffleId.title : 'Sorteo' %></p>
                      <p class="text-muted small mb-0">Monto: <strong>S/<%= payment.amount ? payment.amount.toFixed(2) : '0.00' %></strong> (<%= payment.ticketQty || 1 %> tickets)</p>
                      <p class="text-muted small mb-0">Comprobante en revisión — te notificaremos por WhatsApp y correo.</p>
                    </div>
                  </div>
                  <div>
                    <a href="https://wa.me/51918762620?text=<%= encodeURIComponent(`¡Hola SorteosPeru.pe! Adjunto mi comprobante para validar mi compra de S/${payment.amount ? payment.amount.toFixed(2) : '0.00'} en el sorteo "${payment.raffleId ? payment.raffleId.title : 'Sorteo'}". Mi nombre es ${user.name}.`) %>" target="_blank" class="btn btn-sm btn-success rounded-pill fw-bold" style="background-color: #25D366; border-color: #25D366;">
                      <i class="bi bi-whatsapp me-1"></i> Validar por WhatsApp
                    </a>
                  </div>
                </div>
              </div>
            <% }) %>
            <% rejectedPayments.forEach(payment => { %>
              <div class="card border-0 shadow-sm ticket-card mb-3" style="border-left: 4px solid #ef4444 !important;">
                <div class="card-body p-3 d-flex align-items-center">
                  <i class="bi bi-x-circle-fill text-danger fs-3 me-3"></i>
                  <div>
                    <p class="fw-bold mb-0"><%= payment.raffleId ? payment.raffleId.title : 'Sorteo' %></p>
                    <p class="text-danger small mb-0">Rechazado: <%= payment.rejectionReason || 'Comprobante inválido' %></p>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="card border-0 shadow-sm p-5 text-center ticket-card">
              <i class="bi bi-check-circle text-success" style="font-size: 3rem;"></i>
              <h5 class="fw-bold mt-3">¡Todo al día!</h5>
              <p class="text-muted small">No tienes pagos pendientes.</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- COLUMNA LATERAL -->
    <div class="col-lg-4">
      <!-- ESTADÍSTICAS -->
      <div class="row g-3 mb-4">
        <div class="col-6">
          <div class="card stat-card shadow-sm text-center p-3">
            <h2 class="fw-bold text-primary mb-0"><%= tickets.length %></h2>
            <p class="small text-muted mb-0 fw-bold">Tickets</p>
          </div>
        </div>
        <div class="col-6">
          <div class="card stat-card shadow-sm text-center p-3">
            <h2 class="fw-bold text-warning mb-0"><%= wins ? wins.length : 0 %></h2>
            <p class="small text-muted mb-0 fw-bold">Ganados</p>
          </div>
        </div>
        <div class="col-6">
          <div class="card stat-card shadow-sm text-center p-3">
            <h2 class="fw-bold text-success mb-0"><%= activeTickets.length %></h2>
            <p class="small text-muted mb-0 fw-bold">En Juego</p>
          </div>
        </div>
        <div class="col-6">
          <div class="card stat-card shadow-sm text-center p-3">
            <h2 class="fw-bold text-danger mb-0"><%= pendingPayments.length %></h2>
            <p class="small text-muted mb-0 fw-bold">Pendientes</p>
          </div>
        </div>
      </div>

      <!-- MÓDULO DE NÚMERO CELULAR / WHATSAPP -->
      <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4" id="modulo-whatsapp" style="border: 1px solid rgba(37, 211, 102, 0.3) !important;">
        <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
          <h6 class="fw-bold mb-0 text-theme-light d-flex align-items-center gap-2">
            <span class="rounded-circle d-inline-flex align-items-center justify-content-center text-white" style="width: 32px; height: 32px; background: #25D366; font-size: 1.1rem;">
              <i class="bi bi-whatsapp"></i>
            </span>
            Mi Celular / WhatsApp
          </h6>
          <% if (user.phone) { %>
            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1 rounded-pill" style="font-size: 0.72rem;">
              <i class="bi bi-check-circle-fill me-1"></i> Vinculado
            </span>
          <% } else { %>
            <span class="badge bg-warning text-dark px-2 py-1 rounded-pill" style="font-size: 0.72rem;">
              <i class="bi bi-exclamation-triangle-fill me-1"></i> Sin registrar
            </span>
          <% } %>
        </div>

        <div class="card-body p-4">
          <% if (user.phone) { %>
            <!-- Con teléfono registrado -->
            <div class="p-3 rounded-3 mb-3 d-flex align-items-center justify-content-between" style="background: rgba(37, 211, 102, 0.08); border: 1px solid rgba(37, 211, 102, 0.2);">
              <div>
                <small class="text-muted d-block" style="font-size: 0.75rem;">Número activo</small>
                <span class="fs-5 fw-bold font-monospace text-theme-light">+51 <%= user.phone %></span>
              </div>
              <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" type="button" data-bs-toggle="collapse" data-bs-target="#collapseEditPhone">
                <i class="bi bi-pencil-fill me-1"></i> Cambiar
              </button>
            </div>

            <!-- Formulario colapsable para cambiar número -->
            <div class="collapse mb-3" id="collapseEditPhone">
              <div class="p-3 rounded-3 border bg-body-tertiary">
                <form action="/perfil/telefono" method="POST">
                  <label class="form-label small fw-bold mb-1">Nuevo número (9 dígitos)</label>
                  <div class="input-group input-group-sm mb-2">
                    <span class="input-group-text bg-transparent">+51</span>
                    <input type="tel" name="phone" class="form-control" placeholder="987654321" maxlength="9" pattern="[0-9]{9}" required>
                  </div>
                  <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-success fw-bold rounded-pill flex-grow-1">
                      Guardar Cambios
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill" data-bs-toggle="collapse" data-bs-target="#collapseEditPhone">
                      Cancelar
                    </button>
                  </div>
                </form>
              </div>
            </div>

            <p class="small text-muted mb-3">
              <i class="bi bi-shield-check text-success me-1"></i> Recibirás confirmaciones de tickets y avisos si ganas un sorteo.
            </p>

            <!-- Acciones rápidas de WhatsApp -->
            <div class="d-grid gap-2">
              <%
                const myActiveNums = activeTickets.map(t => t.ticketNumber).join(', ');
                const shareMyActiveMsg = encodeURIComponent(
                  `¡Hola! Estos son mis tickets oficiales de SorteosPeru.pe:\n` +
                  (activeTickets.length > 0 
                    ? `🎫 Tickets: ${myActiveNums}\n🍀 ¡Vamos por el premio!` 
                    : `Aún no tengo tickets activos. ¡Voy a comprar en https://sorteosperu-pe.onrender.com!`)
                );
              %>
              <a href="https://wa.me/51<%= user.phone %>?text=<%= shareMyActiveMsg %>" target="_blank" class="btn btn-sm btn-outline-success fw-bold rounded-pill text-start px-3 py-2">
                <i class="bi bi-send-fill text-success me-2"></i> Enviar mis tickets a mi WhatsApp
              </a>

              <a href="https://wa.me/51918762620?text=<%= encodeURIComponent(`¡Hola SorteosPeru.pe! Soy ${user.name} (Tel: ${user.phone}). Deseo información o soporte sobre mis tickets.`) %>" target="_blank" class="btn btn-sm btn-outline-primary fw-bold rounded-pill text-start px-3 py-2">
                <i class="bi bi-headset text-primary me-2"></i> Soporte Oficial por WhatsApp (918 762 620)
              </a>
            </div>

          <% } else { %>
            <!-- Sin teléfono registrado -->
            <div class="p-3 rounded-3 mb-3" style="background: rgba(245, 158, 11, 0.08); border: 1px solid rgba(245, 158, 11, 0.25);">
              <p class="small text-warning fw-bold mb-1">
                <i class="bi bi-exclamation-triangle-fill me-1"></i> ¡Número no registrado!
              </p>
              <p class="small text-muted mb-0">
                Registra tu celular para recibir la confirmación de tus tickets y llamarte si sales ganador.
              </p>
            </div>

            <form action="/perfil/telefono" method="POST">
              <label class="form-label small fw-bold mb-1">Tu Celular / WhatsApp</label>
              <div class="input-group mb-2">
                <span class="input-group-text bg-transparent text-success fw-bold">
                  <i class="bi bi-whatsapp me-1"></i> +51
                </span>
                <input type="tel" name="phone" class="form-control" placeholder="987654321" maxlength="9" pattern="[0-9]{9}" required>
              </div>
              <small class="text-muted d-block mb-3" style="font-size: 0.72rem;">
                Ingresa exactamente 9 dígitos. Máximo 2 cuentas por número.
              </small>
              <button type="submit" class="btn btn-success w-100 fw-bold rounded-pill shadow-sm" style="background-color: #25D366; border-color: #25D366;">
                <i class="bi bi-check2-circle me-1"></i> Guardar mi WhatsApp
              </button>
            </form>
          <% } %>
        </div>
      </div>

      <!-- CTA -->
      <div class="card border-0 shadow-sm ticket-card overflow-hidden mb-4">
        <div class="card-body p-4 text-center">
          <div style="font-size: 2.5rem;">🍀</div>
          <h6 class="fw-bold mt-2">¡No te quedes con las ganas!</h6>
          <p class="text-muted small mb-3">Mientras más tickets compres, más oportunidades tienes de ganar.</p>
          <a href="/sorteos" class="btn btn-outline-primary btn-sm fw-bold rounded-pill px-4">Ver Sorteos Activos</a>
        </div>
      </div>

      <!-- ÚLTIMOS GANADORES GLOBALES -->
      <% if (recentWinners && recentWinners.length > 0) { %>
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
          <div class="card-header bg-transparent border-bottom-0 pt-4 pb-0">
            <h6 class="fw-bold mb-0"><i class="bi bi-stars text-warning me-1"></i> Últimos Ganadores</h6>
          </div>
          <div class="card-body">
            <% recentWinners.forEach(winner => { %>
              <div class="d-flex align-items-center mb-3 pb-3 border-bottom">
                <div class="rounded-circle d-flex align-items-center justify-content-center me-3 flex-shrink-0" style="width: 45px; height: 45px; background: linear-gradient(135deg, #f59e0b, #fbbf24); color: white; font-weight: bold; font-size: 1.2rem;">
                  <%= winner.userId ? winner.userId.name.charAt(0).toUpperCase() : '?' %>
                </div>
                <div class="flex-grow-1 min-w-0">
                  <h6 class="fw-bold mb-0 text-truncate"><%= winner.userId ? winner.userId.name : 'Usuario' %></h6>
                  <p class="text-success small fw-bold mb-0">Ganó S/<%= winner.prizeValue %></p>
                  <p class="small text-muted mb-0 d-flex align-items-center gap-1">
                    Ticket: <span class="fw-bold font-monospace" style="filter: blur(4px); user-select: none; opacity: 0.8;" title="Oculto por privacidad"><%= winner.ticketId ? winner.ticketId.ticketNumber : 'GC-XXXXXX' %></span>
                  </p>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
