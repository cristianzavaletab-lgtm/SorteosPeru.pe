<%- include('partials/header') %>

<style>
  .gradient-card {
    background: linear-gradient(135deg, #7e22ce, #db2777);
    border-radius: 1.5rem;
    color: white;
    position: relative;
    overflow: hidden;
  }
  .gradient-card::before {
    content: '';
    position: absolute;
    top: -50%; right: -30%;
    width: 300px; height: 300px;
    border-radius: 50%;
    background: rgba(255,255,255,0.08);
  }
  .section-title {
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    padding-bottom: 0.5rem;
    border-bottom: 3px solid;
    display: inline-block;
    margin-bottom: 1rem;
  }
  .ticket-card {
    transition: all 0.3s ease;
    border-radius: 1rem !important;
  }
  .ticket-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.1) !important;
  }
  .next-raffle-card {
    border-left: 5px solid #9333ea;
    animation: glow-border 2s ease-in-out infinite alternate;
    border-radius: 1rem !important;
  }
  @keyframes glow-border {
    from { border-left-color: #9333ea; }
    to { border-left-color: #ec4899; }
  }
  .tab-custom .nav-link {
    color: #6b7280;
    font-weight: 600;
    border: none;
    border-bottom: 3px solid transparent;
    border-radius: 0;
    padding: 0.75rem 1.25rem;
  }
  .tab-custom .nav-link.active {
    color: #9333ea;
    border-bottom-color: #9333ea;
    background: none;
  }
  .tab-custom .nav-link:hover { color: #9333ea; }
  .stat-card {
    border-radius: 1rem !important;
    border: none !important;
    transition: all 0.3s ease;
  }
  .stat-card:hover { transform: translateY(-3px); }
</style>

<div class="container py-4">
  
  <!-- HEADER -->
  <div class="gradient-card p-4 p-md-5 mb-4">
    <div class="d-flex align-items-center">
      <div class="rounded-circle d-inline-flex align-items-center justify-content-center me-3 flex-shrink-0" style="width: 65px; height: 65px; font-size: 1.8rem; background: rgba(255,255,255,0.2);">
        <%= user.name.charAt(0).toUpperCase() %>
      </div>
      <div>
        <h3 class="fw-bold mb-0">¡Hola, <%= user.name.split(' ')[0] %>!</h3>
        <p class="mb-0 opacity-75">Bienvenido a tu panel de SorteosPeru.pe</p>
      </div>
    </div>
  </div>

  <%
    const activeTickets = tickets.filter(t => t.raffleId && t.raffleId.status === 'active');
    const completedTickets = tickets.filter(t => t.raffleId && t.raffleId.status === 'completed');
    const myWinTicketIds = wins ? wins.map(w => w.ticketId ? w.ticketId.toString() : '') : [];
    const pendingPayments = payments.filter(p => p.status === 'pending');
    const rejectedPayments = payments.filter(p => p.status === 'rejected');
    const wonTickets = completedTickets.filter(t => myWinTicketIds.includes(t._id.toString()));
    const lostTickets = completedTickets.filter(t => !myWinTicketIds.includes(t._id.toString()));
  %>

  <!-- BANNER GANADOR -->
  <% if (wins && wins.length > 0) { %>
    <% wins.forEach(win => { %>
      <div class="card border-0 shadow mb-4 ticket-card overflow-hidden" style="border-left: 6px solid #f59e0b !important;">
        <div class="card-body p-4 d-flex align-items-center">
          <div class="me-3" style="font-size: 3rem;">🏆</div>
          <div class="flex-grow-1">
            <h4 class="fw-bold mb-1" style="color: #f59e0b;">¡Felicidades, ganaste!</h4>
            <p class="mb-1">Ganaste <strong class="text-success fs-5">S/<%= win.prizeValue %></strong> en "<%= win.raffleId ? win.raffleId.title : 'Sorteo' %>"</p>
            <% if (win.deliveryStatus === 'delivered') { %>
              <span class="badge bg-success px-3 py-2"><i class="bi bi-check-circle-fill me-1"></i> Premio Entregado</span>
            <% } else { %>
              <span class="badge bg-warning text-dark px-3 py-2"><i class="bi bi-clock-fill me-1"></i> Pendiente de entrega</span>
            <% } %>
          </div>
        </div>
      </div>
    <% }) %>
  <% } %>

  <div class="row g-4">
    <!-- COLUMNA PRINCIPAL -->
    <div class="col-lg-8">

      <!-- PRÓXIMO SORTEO DESTACADO -->
      <% if (nextRaffle) { %>
        <div class="card border-0 shadow-sm next-raffle-card mb-4 overflow-hidden">
          <div class="card-body p-0">
            <div class="row g-0 align-items-center">
              <% if (nextRaffle.image) { %>
                <div class="col-4">
                  <img src="<%= nextRaffle.image %>" class="w-100 h-100" style="object-fit: cover; min-height: 150px;">
                </div>
                <div class="col-8 p-4">
              <% } else { %>
                <div class="col-12 p-4">
              <% } %>
                <div class="d-flex align-items-center mb-2">
                  <span class="badge bg-danger me-2 px-2 py-1" style="animation: pulse-dot 1s infinite alternate;">
                    <i class="bi bi-lightning-charge-fill"></i> NUEVO
                  </span>
                  <small class="text-muted fw-bold">SORTEO ACTIVO</small>
                </div>
                <h4 class="fw-bold mb-1"><%= nextRaffle.title %></h4>
                <h5 class="text-success fw-bold mb-2">Premio: S/<%= nextRaffle.prizeValue %></h5>
                <% if (nextRaffle.drawDate) { %>
                  <p class="small text-muted mb-2">
                    <i class="bi bi-calendar-event"></i>
                    <%= nextRaffle.drawDate.toLocaleDateString('es-PE', {weekday:'short', day:'2-digit', month:'short'}) %> - 
                    <%= nextRaffle.drawDate.toLocaleTimeString('es-PE', {hour:'2-digit', minute:'2-digit', hour12:true}) %>
                  </p>
                <% } %>
                <div class="d-flex gap-2 flex-wrap">
                  <a href="/sorteos/<%= nextRaffle._id %>" class="btn btn-primary fw-bold">
                    <i class="bi bi-ticket-perforated me-1"></i> Participar
                  </a>
                  <a href="/sorteos/<%= nextRaffle._id %>/live" class="btn btn-danger fw-bold" style="animation: pulse 2s infinite;">
                    <i class="bi bi-broadcast me-1"></i> VER EN VIVO
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% } %>

      <!-- TABS DE SECCIONES -->
      <ul class="nav tab-custom mb-3" role="tablist">
        <li class="nav-item">
          <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabActive">
            <i class="bi bi-ticket-perforated-fill me-1"></i> En Juego
            <% if (activeTickets.length > 0) { %><span class="badge bg-primary ms-1"><%= activeTickets.length %></span><% } %>
          </button>
        </li>
        <li class="nav-item">
          <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabWon">
            <i class="bi bi-trophy-fill me-1"></i> Ganados
            <% if (wonTickets.length > 0) { %><span class="badge bg-warning text-dark ms-1"><%= wonTickets.length %></span><% } %>
          </button>
        </li>
        <li class="nav-item">
          <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabHistory">
            <i class="bi bi-clock-history me-1"></i> Historial
            <% if (lostTickets.length > 0) { %><span class="badge bg-secondary ms-1"><%= lostTickets.length %></span><% } %>
          </button>
        </li>
        <li class="nav-item">
          <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabPending">
            <i class="bi bi-hourglass-split me-1"></i> Pendientes
            <% if (pendingPayments.length > 0) { %><span class="badge bg-warning text-dark ms-1"><%= pendingPayments.length %></span><% } %>
          </button>
        </li>
      </ul>

      <div class="tab-content">
        <!-- TAB: EN JUEGO -->
        <div class="tab-pane fade show active" id="tabActive">
          <% if (activeTickets.length > 0) { %>
            <div class="row g-3">
              <% activeTickets.forEach(ticket => { %>
                <div class="col-sm-6">
                  <div class="card border-0 shadow-sm ticket-card h-100" style="border-top: 4px solid #22c55e !important;">
                    <div class="card-body text-center p-4">
                      <span class="badge bg-success mb-2"><i class="bi bi-check-circle-fill me-1"></i> Activo</span>
                      <p class="text-muted small mb-1">Ticket</p>
                      <h3 class="ticket-number mb-2"><%= ticket.ticketNumber %></h3>
                      <p class="fw-bold mb-1"><%= ticket.raffleId.title %></p>
                      <p class="text-success fw-bold mb-0">Premio: S/<%= ticket.raffleId.prizeValue %></p>
                      <% if (ticket.raffleId.drawDate) { %>
                        <p class="small text-primary mt-2 mb-0">
                          <i class="bi bi-clock"></i> 
                          <%= ticket.raffleId.drawDate.toLocaleDateString('es-PE', {day:'2-digit', month:'short'}) %> - 
                          <%= ticket.raffleId.drawDate.toLocaleTimeString('es-PE', {hour:'2-digit', minute:'2-digit', hour12:true}) %>
                        </p>
                      <% } %>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <div class="card border-0 shadow-sm p-5 text-center ticket-card">
              <i class="bi bi-ticket-perforated text-muted" style="font-size: 3rem;"></i>
              <h5 class="fw-bold mt-3">Sin tickets activos</h5>
              <p class="text-muted small">Compra un ticket para participar en el próximo sorteo.</p>
              <a href="/sorteos" class="btn btn-primary">Ver Sorteos</a>
            </div>
          <% } %>
        </div>

        <!-- TAB: GANADOS -->
        <div class="tab-pane fade" id="tabWon">
          <% if (wonTickets.length > 0) { %>
            <% wonTickets.forEach(ticket => { %>
              <div class="card border-0 shadow-sm ticket-card mb-3" style="border-left: 5px solid #f59e0b !important;">
                <div class="card-body p-4 d-flex align-items-center">
                  <div class="me-3" style="font-size: 2.5rem;">🎉</div>
                  <div>
                    <span class="badge bg-warning text-dark mb-1">¡GANADOR!</span>
                    <h5 class="fw-bold mb-1"><%= ticket.raffleId.title %></h5>
                    <p class="mb-0 small">Ticket ganador: <strong><%= ticket.ticketNumber %></strong></p>
                    <p class="mb-0 text-success fw-bold">Premio: S/<%= ticket.raffleId.prizeValue %></p>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="card border-0 shadow-sm p-5 text-center ticket-card">
              <i class="bi bi-trophy text-muted" style="font-size: 3rem;"></i>
              <h5 class="fw-bold mt-3">Aún no has ganado</h5>
              <p class="text-muted small">¡Sigue participando, la suerte está de tu lado!</p>
            </div>
          <% } %>
        </div>

        <!-- TAB: HISTORIAL -->
        <div class="tab-pane fade" id="tabHistory">
          <% if (lostTickets.length > 0) { %>
            <% lostTickets.forEach(ticket => { %>
              <div class="card border-0 shadow-sm ticket-card mb-3">
                <div class="card-body p-3 d-flex align-items-center">
                  <div class="me-3" style="font-size: 1.5rem;">📋</div>
                  <div class="flex-grow-1">
                    <div class="d-flex justify-content-between align-items-center">
                      <div>
                        <h6 class="fw-bold mb-0"><%= ticket.raffleId.title %></h6>
                        <p class="text-muted small mb-0">Ticket: <%= ticket.ticketNumber %></p>
                      </div>
                      <span class="badge bg-secondary">No ganador</span>
                    </div>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="card border-0 shadow-sm p-5 text-center ticket-card">
              <i class="bi bi-clock-history text-muted" style="font-size: 3rem;"></i>
              <h5 class="fw-bold mt-3">Sin historial</h5>
              <p class="text-muted small">Tus sorteos pasados aparecerán aquí.</p>
            </div>
          <% } %>
        </div>

        <!-- TAB: PENDIENTES -->
        <div class="tab-pane fade" id="tabPending">
          <% if (pendingPayments.length > 0 || rejectedPayments.length > 0) { %>
            <% pendingPayments.forEach(payment => { %>
              <div class="card border-0 shadow-sm ticket-card mb-3" style="border-left: 4px solid #eab308 !important;">
                <div class="card-body p-3 d-flex align-items-center">
                  <i class="bi bi-clock-fill text-warning fs-3 me-3"></i>
                  <div>
                    <p class="fw-bold mb-0"><%= payment.raffleId ? payment.raffleId.title : 'Sorteo' %></p>
                    <p class="text-muted small mb-0">Comprobante en revisión — te notificaremos por WhatsApp.</p>
                  </div>
                </div>
              </div>
            <% }) %>
            <% rejectedPayments.forEach(payment => { %>
              <div class="card border-0 shadow-sm ticket-card mb-3" style="border-left: 4px solid #ef4444 !important;">
                <div class="card-body p-3 d-flex align-items-center">
                  <i class="bi bi-x-circle-fill text-danger fs-3 me-3"></i>
                  <div>
                    <p class="fw-bold mb-0"><%= payment.raffleId ? payment.raffleId.title : 'Sorteo' %></p>
                    <p class="text-danger small mb-0">Rechazado: <%= payment.rejectionReason || 'Comprobante inválido' %></p>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="card border-0 shadow-sm p-5 text-center ticket-card">
              <i class="bi bi-check-circle text-success" style="font-size: 3rem;"></i>
              <h5 class="fw-bold mt-3">¡Todo al día!</h5>
              <p class="text-muted small">No tienes pagos pendientes.</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- COLUMNA LATERAL -->
    <div class="col-lg-4">
      <!-- ESTADÍSTICAS -->
      <div class="row g-3 mb-4">
        <div class="col-6">
          <div class="card stat-card shadow-sm text-center p-3" style="background: linear-gradient(135deg, #ede9fe, #fce7f3);">
            <h2 class="fw-bold text-primary mb-0"><%= tickets.length %></h2>
            <p class="small text-muted mb-0 fw-bold">Tickets</p>
          </div>
        </div>
        <div class="col-6">
          <div class="card stat-card shadow-sm text-center p-3" style="background: linear-gradient(135deg, #fef3c7, #fde68a);">
            <h2 class="fw-bold text-warning mb-0"><%= wins ? wins.length : 0 %></h2>
            <p class="small text-muted mb-0 fw-bold">Ganados</p>
          </div>
        </div>
        <div class="col-6">
          <div class="card stat-card shadow-sm text-center p-3" style="background: linear-gradient(135deg, #d1fae5, #a7f3d0);">
            <h2 class="fw-bold text-success mb-0"><%= activeTickets.length %></h2>
            <p class="small text-muted mb-0 fw-bold">En Juego</p>
          </div>
        </div>
        <div class="col-6">
          <div class="card stat-card shadow-sm text-center p-3" style="background: linear-gradient(135deg, #fee2e2, #fecaca);">
            <h2 class="fw-bold text-danger mb-0"><%= pendingPayments.length %></h2>
            <p class="small text-muted mb-0 fw-bold">Pendientes</p>
          </div>
        </div>
      </div>

      <!-- CTA -->
      <div class="card border-0 shadow-sm ticket-card overflow-hidden mb-4">
        <div class="card-body p-4 text-center" style="background: linear-gradient(135deg, #faf5ff, #fdf2f8);">
          <div style="font-size: 2.5rem;">🍀</div>
          <h6 class="fw-bold mt-2">¡No te quedes con las ganas!</h6>
          <p class="text-muted small mb-3">Mientras más tickets compres, más oportunidades tienes de ganar.</p>
          <a href="/sorteos" class="btn btn-outline-primary btn-sm fw-bold rounded-pill px-4">Ver Sorteos Activos</a>
        </div>
      </div>

      <!-- ÚLTIMOS GANADORES GLOBALES -->
      <% if (recentWinners && recentWinners.length > 0) { %>
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
          <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
            <h6 class="fw-bold mb-0"><i class="bi bi-stars text-warning me-1"></i> Últimos Ganadores</h6>
          </div>
          <div class="card-body">
            <% recentWinners.forEach(winner => { %>
              <div class="d-flex align-items-center mb-3 pb-3 border-bottom">
                <div class="rounded-circle d-flex align-items-center justify-content-center me-3 flex-shrink-0" style="width: 45px; height: 45px; background: linear-gradient(135deg, #f59e0b, #fbbf24); color: white; font-weight: bold; font-size: 1.2rem;">
                  <%= winner.userId ? winner.userId.name.charAt(0).toUpperCase() : '?' %>
                </div>
                <div class="flex-grow-1 min-w-0">
                  <h6 class="fw-bold mb-0 text-truncate"><%= winner.userId ? winner.userId.name : 'Usuario' %></h6>
                  <p class="text-success small fw-bold mb-0">Ganó S/<%= winner.prizeValue %></p>
                  <p class="small text-muted mb-0 d-flex align-items-center gap-1">
                    Ticket: <span class="fw-bold font-monospace" style="filter: blur(4px); user-select: none; opacity: 0.8;" title="Oculto por privacidad"><%= winner.ticketId ? winner.ticketId.ticketNumber : 'GC-XXXXXX' %></span>
                  </p>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
