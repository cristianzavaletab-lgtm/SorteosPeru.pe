<!-- Bootstrap 5 JS Bundle with Popper -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<!-- Global Realtime Updates -->
<script src="/socket.io/socket.io.js"></script>
<script>
  const globalSocket = io();
  
  <% if (typeof user !== 'undefined' && user) { %>
    const myUserId = "<%= user._id %>";
    const userRole = "<%= user.role %>";

    globalSocket.on('user_update', (data) => {
      if (data.userId === myUserId) {
        showToastNotification(data.message, 'success');
      }
    });

    if (userRole === 'admin') {
      globalSocket.on('admin_update', (data) => {
        showToastNotification('🔔 Admin: ' + data.message, 'info');
      });
    }

    function showToastNotification(message, type) {
      const bgClass = type === 'success' ? 'bg-success' : 'bg-primary';
      const toastHtml = `
        <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1050">
          <div class="toast align-items-center text-white ${bgClass} border-0 show" role="alert" data-bs-autohide="true" data-bs-delay="4000">
            <div class="d-flex">
              <div class="toast-body fw-bold">
                ${message} <br><small>Actualizando vista...</small>
              </div>
              <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
          </div>
        </div>
      `;
      document.body.insertAdjacentHTML('beforeend', toastHtml);
      setTimeout(() => {
        window.location.reload();
      }, 2500);
    }
  <% } %>
</script>
</body>
</html>
