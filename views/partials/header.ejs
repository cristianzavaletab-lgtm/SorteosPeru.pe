<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SorteosPeru.pe - Gana premios reales</title>
  
  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;800&display=swap" rel="stylesheet">
  
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">
  
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

  <!-- PWA Support -->
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#5B21B6">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="SorteosPeru">
  <link rel="apple-touch-icon" href="/images/icons/icon-192x192.png">

  <!-- Theme Setup Script (pre-render para evitar parpadeos) -->
  <script>
    const savedTheme = localStorage.getItem('theme') || 'dark';
    if (savedTheme === 'light') {
      document.documentElement.setAttribute('data-theme', 'light');
    }
  </script>
</head>
<body>
<!-- Banner Top Promocional -->
<div class="bg-primary text-white text-center py-2" style="background: linear-gradient(90deg, var(--primary-color), var(--secondary-color)); font-size: 0.9rem;">
  <div class="container fw-bold">
    <i class="bi bi-gift-fill text-warning me-1"></i> 
    ¿Tienes un código de un Negocio Aliado? 
    <a href="/canjear" class="text-white text-decoration-underline ms-1">Canjéalo aquí y obtén tu ticket gratis</a>
  </div>
</div>

<nav class="navbar navbar-expand-lg sticky-top">
  <div class="container">
    <a class="navbar-brand brand-text" href="/">
      <i class="bi bi-graph-up-arrow"></i> SorteosPeru<span style="color:var(--accent-color)">.</span>pe
    </a>
    <div class="d-flex align-items-center ms-auto d-lg-none me-2">
      <!-- Theme Toggle (Mobile) -->
      <button id="themeToggleMobile" class="btn btn-link nav-link px-2 text-decoration-none" onclick="toggleTheme()">
        <i class="bi bi-moon-stars-fill fs-4" id="themeIconMobile"></i>
      </button>
    </div>

    <button class="navbar-toggler border-0 shadow-none px-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <i class="bi bi-list fs-1" style="color: var(--text-light);"></i>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav me-auto">
        <li class="nav-item">
          <a class="nav-link fw-semibold" href="/sorteos"><i class="bi bi-trophy-fill me-2 text-primary"></i>Sorteos Activos</a>
        </li>
        <li class="nav-item">
          <a class="nav-link fw-semibold text-warning" href="/negocios"><i class="bi bi-star-fill me-2"></i>Negocios Aliados</a>
        </li>
        <li class="nav-item">
          <a class="nav-link fw-semibold" href="/canjear"><i class="bi bi-ticket-perforated-fill me-2 text-info"></i>Canjear Código</a>
        </li>
        <li class="nav-item">
          <a class="nav-link fw-bold text-success" href="/mis-tickets"><i class="bi bi-search me-2"></i>Buscar mis tickets</a>
        </li>
        <% if (user) { %>
        <li class="nav-item">
          <a class="nav-link fw-bold text-success" href="/recompensas"><i class="bi bi-gift-fill small me-1"></i>Recompensas</a>
        </li>
        <% } %>
      </ul>
      <ul class="navbar-nav align-items-center">
        <!-- Theme Toggle (Desktop) -->
        <li class="nav-item me-3 d-none d-lg-block">
          <button id="themeToggleDesktop" class="btn btn-link nav-link px-0 text-decoration-none" onclick="toggleTheme()">
            <i class="bi bi-moon-stars-fill fs-5" id="themeIconDesktop"></i>
          </button>
        </li>
        <% if (user) { %>
          <li class="nav-item d-flex align-items-center me-2">
            <span class="badge bg-warning text-dark rounded-pill px-3 py-2 shadow-sm fw-bold">
              <i class="bi bi-coin me-1"></i> <%= user.credits || 0 %> SP
            </span>
          </li>
          
          <!-- Notificaciones -->
          <li class="nav-item dropdown me-2">
            <a class="nav-link px-2 notification-bell" href="#" id="notiDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="bi bi-bell-fill fs-5"></i>
              <span class="notification-badge d-none" id="notiCount">0</span>
            </a>
            <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 bg-theme-card notification-dropdown" aria-labelledby="notiDropdown">
              <div class="p-3 border-bottom border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold text-theme-light">Notificaciones</h6>
                <button class="btn btn-sm btn-link text-decoration-none p-0 text-theme-muted" onclick="markAllAsRead()">Limpiar</button>
              </div>
              <div id="notiList" class="py-0">
                <!-- Se cargan por JS -->
                <div class="p-4 text-center text-theme-muted small">
                  <i class="bi bi-bell-slash d-block fs-3 mb-2 opacity-50"></i>
                  No tienes notificaciones
                </div>
              </div>
            </div>
          </li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle fw-bold" href="#" role="button" data-bs-toggle="dropdown" style="background: var(--glass-bg); -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px); border: 1px solid var(--accent-color);">
              <i class="bi bi-person-circle" style="color: var(--accent-color);"></i> Mi Cuenta
            </a>
            <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg">
              <% if (user.role === 'admin') { %>
                <li><a class="dropdown-item py-2" href="/admin"><i class="bi bi-speedometer2 me-2"></i>Panel Admin</a></li>
                <li><hr class="dropdown-divider border-secondary opacity-25"></li>
              <% } else if (user.role === 'vendor') { %>
                <li><a class="dropdown-item py-2 text-warning" href="/vendor/dashboard"><i class="bi bi-person-badge me-2"></i>Panel Vendedor</a></li>
                <li><hr class="dropdown-divider border-secondary opacity-25"></li>
              <% } %>
              <li><a class="dropdown-item py-2" href="/dashboard"><i class="bi bi-ticket-perforated me-2"></i>Mis Tickets</a></li>
              <li><hr class="dropdown-divider border-secondary opacity-25"></li>
              <li><a class="dropdown-item text-danger py-2" href="/auth/logout"><i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión</a></li>
            </ul>
          </li>
        <% } else { %>
          <li class="nav-item">
            <a class="nav-link" href="/login">Iniciar Sesión</a>
          </li>
          <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
            <a class="btn btn-primary px-4 rounded-pill" href="/register">Registrarse</a>
          </li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>

<!-- PWA Install Banner (Hidden by default) -->
<div id="pwaBanner" class="pwa-banner d-none">
  <div class="pwa-banner-content">
    <div class="pwa-banner-icon" style="background: transparent; box-shadow: none;">
      <img src="/images/logo-sp.png" alt="SP" style="width: 100%; height: 100%; object-fit: contain; border-radius: 12px;">
    </div>
    <div class="pwa-banner-text">
      <h6>Instala SorteosPeru.pe</h6>
      <p>Acceso rápido y mejor experiencia sin conexión</p>
    </div>
  </div>
  <div class="pwa-banner-actions">
    <button id="pwaInstallBtn" class="btn-pwa-install">INSTALAR</button>
    <button id="pwaCloseBanner" class="btn-pwa-close" onclick="closePwaBanner()">
      <i class="bi bi-x-lg"></i>
    </button>
  </div>
</div>

<script>
  const themeIconMobile = document.getElementById('themeIconMobile');
  const themeIconDesktop = document.getElementById('themeIconDesktop');
  
  function updateIcon(theme) {
    const iconClass = theme === 'light' ? 'bi bi-sun-fill text-warning' : 'bi bi-moon-stars-fill';
    if (themeIconMobile) themeIconMobile.className = iconClass + ' fs-4';
    if (themeIconDesktop) themeIconDesktop.className = iconClass + ' fs-5';
  }

  // Inicializar icono
  updateIcon(document.documentElement.getAttribute('data-theme') || 'dark');

  function toggleTheme() {
    let currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
    let newTheme = currentTheme === 'dark' ? 'light' : 'dark';
    
    if (newTheme === 'light') {
      document.documentElement.setAttribute('data-theme', 'light');
    } else {
      document.documentElement.removeAttribute('data-theme');
    }
    
    localStorage.setItem('theme', newTheme);
    updateIcon(newTheme);
  }

  // Register Service Worker for PWA
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js')
        .then(reg => console.log('Service Worker registrado con éxito:', reg.scope))
        .catch(err => console.log('Error al registrar el Service Worker:', err));
    });
  }

  // PWA Install Prompt Logic
  let deferredPrompt;
  const pwaBanner = document.getElementById('pwaBanner');
  const pwaInstallBtn = document.getElementById('pwaInstallBtn');

  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferredPrompt = e;
    
    // Solo mostrar si el usuario no lo ha cerrado antes en esta sesión
    if (!sessionStorage.getItem('pwaBannerDismissed')) {
      if (pwaBanner) pwaBanner.classList.remove('d-none');
    }
    console.log('PWA: Ready to install');
  });

  if (pwaInstallBtn) {
    pwaInstallBtn.addEventListener('click', async () => {
      if (!deferredPrompt) return;
      deferredPrompt.prompt();
      const { outcome } = await deferredPrompt.userChoice;
      console.log(`PWA: User response to install: ${outcome}`);
      deferredPrompt = null;
      if (pwaBanner) pwaBanner.classList.add('d-none');
    });
  }

  function closePwaBanner() {
    if (pwaBanner) pwaBanner.classList.add('d-none');
    sessionStorage.setItem('pwaBannerDismissed', 'true');
  }

  window.addEventListener('appinstalled', () => {
    console.log('PWA: App instalada correctamente');
    if (pwaBanner) pwaBanner.classList.add('d-none');
  });

  // --- Push Notifications Logic ---
  const VAPID_PUBLIC_KEY = 'BPU87mKUEnyvYNtBeCVnzpcXOk4ije29fPLVhUS31iD_Qp-Dx7oY_o66UBCEospG7jswmJm3peZsAalbiDhlD6c';

  function urlBase64ToUint8Array(base64String) {
    const padding = '='.repeat((4 - base64String.length % 4) % 4);
    const base64 = (base64String + padding).replace(/\-/g, '+').replace(/_/g, '/');
    const rawData = window.atob(base64);
    const outputArray = new Uint8Array(rawData.length);
    for (let i = 0; i < rawData.length; ++i) {
      outputArray[i] = rawData.charCodeAt(i);
    }
    return outputArray;
  }

  async function subscribeUserToPush() {
    try {
      const registration = await navigator.serviceWorker.ready;
      
      // Verificar si ya tiene suscripción
      const existingSubscription = await registration.pushManager.getSubscription();
      if (existingSubscription) return;

      const subscription = await registration.pushManager.subscribe({
        userVisibleOnly: true,
        applicationServerKey: urlBase64ToUint8Array(VAPID_PUBLIC_KEY)
      });

      await fetch('/push/subscribe', {
        method: 'POST',
        body: JSON.stringify({ subscription }),
        headers: { 'Content-Type': 'application/json' }
      });
      console.log('PWA: Usuario suscrito a notificaciones push');
    } catch (err) {
      console.error('PWA: Error al suscribir a push:', err);
    }
  }

  // Si el usuario está logueado, intentar suscribir
  <% if (user) { %>
    if ('serviceWorker' in navigator && 'PushManager' in window) {
      if (Notification.permission === 'default') {
        setTimeout(() => {
          Notification.requestPermission().then(permission => {
            if (permission === 'granted') subscribeUserToPush();
          });
        }, 5000);
      } else if (Notification.permission === 'granted') {
        subscribeUserToPush();
      }
    }

    // --- Lógica de Notificaciones Internas ---
    const notiCount = document.getElementById('notiCount');
    const notiList = document.getElementById('notiList');
    let unreadCount = 0;

    async function loadNotifications() {
      try {
        const res = await fetch('/notifications');
        const notifications = await res.json();
        renderNotifications(notifications);
      } catch (err) { console.error('Error al cargar notificaciones:', err); }
    }

    function renderNotifications(notifications) {
      if (!notifications || notifications.length === 0) return;
      unreadCount = notifications.filter(n => !n.isRead).length;
      updateBadge();

      notiList.innerHTML = notifications.map(n => `
        <div class="notification-item ${n.isRead ? '' : 'unread'}" onclick="markAsRead('${n._id}', '${n.link}')">
          <div class="title text-theme-light">${n.title}</div>
          <div class="message">${n.message}</div>
          <div class="time">${new Date(n.createdAt).toLocaleString()}</div>
        </div>
      `).join('');
    }

    function updateBadge() {
      if (unreadCount > 0) {
        notiCount.textContent = unreadCount > 9 ? '9+' : unreadCount;
        notiCount.classList.remove('d-none');
      } else {
        notiCount.classList.add('d-none');
      }
    }

    async function markAsRead(id, link) {
      try {
        await fetch(`/notifications/${id}/read`, { method: 'POST' });
        if (link) window.location.href = link;
        else loadNotifications();
      } catch (err) { console.error(err); }
    }

    // Escuchar notificaciones en tiempo real
    socket.on('notification_admin', (noti) => {
      <% if (user.role === 'admin') { %>
        showToastNotification(noti);
        loadNotifications();
      <% } %>
    });

    socket.on('notification_all', (noti) => {
      showToastNotification(noti);
      loadNotifications();
    });

    socket.on('notification_<%= user._id %>', (noti) => {
      showToastNotification(noti);
      loadNotifications();
    });

    function showToastNotification(noti) {
      // Usar el API de Notificaciones del navegador si hay permiso
      if (Notification.permission === 'granted') {
        new Notification(noti.title, { body: noti.message, icon: '/images/icons/icon-192x192.png' });
      }
      // Reproducir sonido suave (opcional)
      const audio = new Audio('/sounds/notification.mp3');
      audio.play().catch(() => {});
    }

    loadNotifications();
  <% } %>
</script>

<!-- Contenido principal -->
<main class="min-vh-100">
