<%- include('./partials/header') %>

<style>
    /* Usar variables nativas del proyecto para el theme */
    .search-hero-container {
        position: relative;
        z-index: 10;
        padding: 4rem 2rem;
        background: var(--card-bg);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid var(--border-color);
        border-radius: 2rem;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15), inset 0 1px 0 rgba(255, 255, 255, 0.05);
        overflow: hidden;
    }

    .search-hero-container::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; height: 4px;
        background: linear-gradient(90deg, transparent, var(--accent-color), transparent);
        animation: scanline 4s linear infinite;
    }

    @keyframes scanline {
        0% { transform: translateX(-100%); }
        100% { transform: translateX(100%); }
    }

    .search-input-group {
        position: relative;
        transition: all 0.3s ease;
    }

    .search-input-group:focus-within {
        transform: translateY(-2px);
        box-shadow: 0 15px 30px var(--glow-gold);
    }

    .search-input {
        background: var(--input-bg) !important;
        border: 2px solid var(--border-color) !important;
        color: var(--text-light) !important;
        padding: 1.2rem 1.5rem !important;
        font-size: 1.2rem !important;
        border-radius: 1rem 0 0 1rem !important;
        transition: all 0.3s ease;
    }

    .search-input:focus {
        border-color: var(--accent-color) !important;
        box-shadow: inset 0 0 15px var(--glow-gold) !important;
    }

    .search-btn {
        background: var(--accent-color) !important;
        color: #000 !important;
        border: none !important;
        padding: 0 2.5rem !important;
        font-weight: 800 !important;
        font-size: 1.1rem !important;
        letter-spacing: 1px !important;
        border-radius: 0 1rem 1rem 0 !important;
        transition: all 0.3s ease !important;
    }

    .search-btn:hover {
        background: var(--accent-light) !important;
        box-shadow: 0 0 20px var(--glow-gold);
    }

    /* Ticket VIP Card */
    .ticket-vip-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 1.5rem;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        position: relative;
        overflow: hidden;
    }
    
    .ticket-vip-card:hover {
        transform: translateY(-8px) scale(1.02);
        box-shadow: 0 20px 40px rgba(0,0,0,0.1), 0 0 20px var(--glow-gold);
        border-color: var(--accent-color);
    }

    .ticket-vip-card::after {
        content: '';
        position: absolute;
        top: 0; left: -100%; width: 50%; height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.05), transparent);
        transform: skewX(-20deg);
        transition: 0.5s;
    }

    .ticket-vip-card:hover::after {
        left: 150%;
    }

    .ticket-number-display {
        background: var(--bg-darker);
        border: 2px dashed var(--accent-color);
        color: var(--text-gold);
        letter-spacing: 4px;
        text-shadow: 0 0 15px var(--glow-gold);
        box-shadow: inset 0 0 20px rgba(245, 197, 66, 0.1);
    }
    
    .floating-element {
        animation: floating 3s ease-in-out infinite;
    }

    @keyframes floating {
        0% { transform: translateY(0px); }
        50% { transform: translateY(-10px); }
        100% { transform: translateY(0px); }
    }
    
    /* Utility fix for text colors in light/dark */
    .text-theme-light { color: var(--text-light) !important; }
    .text-theme-muted { color: var(--text-muted) !important; }
</style>

<div class="container py-5 my-md-5" style="min-height: 80vh;">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            
            <div class="search-hero-container text-center mb-5">
                <div class="floating-element d-inline-block bg-warning text-dark px-4 py-2 rounded-pill fw-bold text-uppercase small tracking-widest mb-4 shadow" style="letter-spacing: 2px;">
                    <i class="bi bi-shield-check me-2 fs-5 align-middle"></i> Sistema de Verificación
                </div>
                
                <h1 class="display-4 fw-black mb-3 text-theme-light" style="text-shadow: 0 4px 10px rgba(0,0,0,0.1);">
                    Consulta tus Tickets
                </h1>
                
                <p class="text-theme-muted fs-5 mb-5 px-md-5">
                    ¿Compraste mediante un promotor o por WhatsApp? Ingresa tu número de celular para verificar que tus tickets están <strong class="text-success">aprobados</strong> y participando en el sorteo.
                </p>

                <% if (error) { %>
                    <div class="alert alert-danger d-flex align-items-center rounded-4 border-0 shadow-lg mx-md-4 mb-5" style="background: rgba(239, 68, 68, 0.1); border-left: 5px solid #ef4444 !important;">
                        <i class="bi bi-exclamation-octagon-fill fs-2 me-3 text-danger"></i>
                        <div class="text-start">
                            <h6 class="fw-bold text-danger mb-0">Error de búsqueda</h6>
                            <small class="text-danger text-opacity-75"><%= error %></small>
                        </div>
                    </div>
                <% } %>

                <form action="/mis-tickets" method="POST" class="px-md-4">
                    <div class="search-input-group d-flex shadow-lg rounded-4">
                        <span class="input-group-text border-end-0 rounded-start-4 ps-4 pe-2" style="background: var(--input-bg); border-color: var(--border-color); color: var(--primary-color);">
                            <i class="bi bi-whatsapp fs-4"></i>
                        </span>
                        <input type="tel" name="phone" class="search-input form-control border-start-0 border-end-0 rounded-0" placeholder="Ej. 987654321" value="<%= phone || '' %>" required autofocus autocomplete="off">
                        <button class="search-btn btn" type="submit">
                            <i class="bi bi-search me-2"></i> BUSCAR
                        </button>
                    </div>
                    <div class="form-text text-theme-muted mt-3 small">
                        <i class="bi bi-lock-fill me-1"></i> Tu número está protegido y solo se usa para buscar tus tickets.
                    </div>
                </form>
            </div>

            <% if (tickets !== null) { %>
                <div class="results-section mt-5 position-relative">
                    <div class="d-flex justify-content-between align-items-center mb-4 pb-3" style="border-bottom: 1px solid var(--border-color);">
                        <h3 class="fw-bold text-theme-light mb-0 d-flex align-items-center">
                            <i class="bi bi-ticket-detailed-fill text-warning me-3 fs-2"></i>
                            Resultados para <span class="text-warning ms-2"><%= phone %></span>
                        </h3>
                        <span class="badge rounded-pill px-3 py-2" style="background: var(--primary-light); color: var(--primary-color); border: 1px solid var(--border-color);"><%= tickets.length %> tickets encontrados</span>
                    </div>

                    <% if (tickets.length > 0) { %>
                        <div class="row g-4">
                            <% tickets.forEach(ticket => { %>
                                <% const isWinner = ticket.status === 'winner'; %>
                                <% const isRaffleFinished = ticket.raffleId && ticket.raffleId.status === 'completed'; %>
                                <div class="col-md-6 col-xl-6">
                                    <div class="ticket-vip-card p-4 h-100 d-flex flex-column justify-content-between" style="<%= isWinner ? 'border-color: #f59e0b; box-shadow: 0 0 30px rgba(245, 158, 11, 0.3);' : '' %>">
                                        <!-- Top Info -->
                                        <div>
                                            <div class="d-flex justify-content-between align-items-start mb-3">
                                                <% if (isWinner) { %>
                                                    <div class="badge bg-warning text-dark border border-warning px-3 py-2 rounded-pill fw-bold shadow-sm d-flex align-items-center" style="animation: pulse-dot 1s infinite alternate;">
                                                        <i class="bi bi-trophy-fill me-2"></i> ¡TICKET GANADOR!
                                                    </div>
                                                <% } else if (isRaffleFinished) { %>
                                                    <div class="badge bg-secondary bg-opacity-25 text-theme-muted border border-secondary border-opacity-50 px-3 py-2 rounded-pill fw-bold shadow-sm d-flex align-items-center">
                                                        <i class="bi bi-x-circle me-2"></i> FINALIZADO
                                                    </div>
                                                <% } else { %>
                                                    <div class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-50 px-3 py-2 rounded-pill fw-bold shadow-sm d-flex align-items-center">
                                                        <span class="spinner-grow spinner-grow-sm me-2" style="width: 0.5rem; height: 0.5rem;" role="status"></span>
                                                        PARTICIPANDO
                                                    </div>
                                                <% } %>
                                                <div class="text-theme-muted small d-flex flex-column align-items-end">
                                                    <span class="fw-bold"><i class="bi bi-calendar-event me-1"></i><%= new Date(ticket.createdAt).toLocaleDateString('es-PE', { day: '2-digit', month: 'short' }) %></span>
                                                    <span style="opacity: 0.7;"><%= new Date(ticket.createdAt).toLocaleTimeString('es-PE', { hour: '2-digit', minute:'2-digit' }) %></span>
                                                </div>
                                            </div>
                                            
                                            <h5 class="fw-bold text-theme-light mb-2 lh-sm"><%= ticket.raffleId ? ticket.raffleId.title : 'Sorteo Finalizado' %></h5>
                                            <p class="text-theme-muted small fw-medium mb-0">
                                                <i class="bi bi-person-bounding-box me-2 text-warning"></i>A nombre de: <span class="text-theme-light"><%= ticket.guestName || 'Cliente Invitado' %></span>
                                            </p>
                                        </div>
                                        
                                        <!-- Bottom Info (Ticket Number) -->
                                        <div class="mt-4 text-center">
                                            <p class="text-theme-muted small text-uppercase fw-bold tracking-widest mb-2" style="letter-spacing: 2px;">Número Oficial</p>
                                            <div class="ticket-number-display display-6 fw-bold px-4 py-3 rounded-4 font-monospace mx-auto d-inline-block" style="<%= isWinner ? 'background: rgba(245, 158, 11, 0.2); color: #f59e0b; border-color: #f59e0b;' : '' %>">
                                                <%= ticket.ticketNumber %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <div class="text-center py-5 px-4 rounded-4" style="background: var(--card-bg); border: 2px dashed var(--border-color);">
                            <div class="floating-element d-inline-flex justify-content-center align-items-center rounded-circle mb-4 shadow-lg" style="width: 100px; height: 100px; background: rgba(239, 68, 68, 0.1); color: #ef4444; border: 2px solid rgba(239, 68, 68, 0.2);">
                                <i class="bi bi-search fs-1"></i>
                            </div>
                            <h3 class="fw-bold text-theme-light mb-3">No encontramos tickets válidos</h3>
                            <p class="text-theme-muted fs-5 mb-0 mx-auto" style="max-width: 500px;">
                                No hay tickets aprobados para el número <strong><%= phone %></strong>.<br><br>
                                <span class="badge border text-wrap p-3 lh-base" style="background: var(--bg-darker); border-color: var(--border-color) !important; color: var(--text-light);">
                                    <i class="bi bi-info-circle text-info me-2"></i>Si pagaste recientemente a un promotor, es posible que el Administrador central aún no haya validado tu pago. Intenta de nuevo más tarde.
                                </span>
                            </p>
                        </div>
                    <% } %>
                </div>
                <!-- Banner Registro -->
                <div class="mt-5 p-4 rounded-4" style="background: linear-gradient(135deg, rgba(91, 33, 182, 0.2), rgba(217, 70, 239, 0.1)); border: 1px solid var(--border-color);">
                    <div class="d-flex flex-column flex-md-row align-items-center justify-content-between text-center text-md-start">
                        <div class="mb-3 mb-md-0">
                            <h4 class="fw-bold text-theme-light mb-1">
                                <i class="bi bi-star-fill text-warning me-2"></i>¿Quieres ganar Tickets y SP Gratis?
                            </h4>
                            <p class="text-theme-muted mb-0">Crea tu cuenta oficial vinculando el número <strong><%= phone %></strong> para administrar todos tus premios.</p>
                        </div>
                        <a href="/register?phone=<%= phone %>" class="btn btn-primary btn-lg rounded-pill px-4 fw-bold shadow-sm" style="background: var(--primary-color); border: none;">
                            Crear mi Cuenta
                        </a>
                    </div>
                </div>
            <% } %>

        </div>
    </div>
</div>

<%- include('./partials/footer') %>
