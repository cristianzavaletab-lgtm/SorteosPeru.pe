<%- include('../partials/header') %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">Panel de Administración</h2>
    <form action="/admin" method="GET" class="d-flex align-items-center">
      <label class="me-2 text-muted small fw-bold text-nowrap">Filtrar métricas por:</label>
      <select name="raffleId" class="form-select form-select-sm" onchange="this.form.submit()" style="min-width: 200px;">
        <option value="">Todos los sorteos</option>
        <% if (locals.allRaffles && locals.allRaffles.length > 0) { %>
          <% allRaffles.forEach(r => { %>
            <option value="<%= r._id %>" <%= locals.selectedRaffleId == r._id ? 'selected' : '' %>>
              <%= r.title %>
            </option>
          <% }) %>
        <% } %>
      </select>
    </form>
  </div>

  <div class="row g-3 g-md-4 mb-5">
    <div class="col-sm-6 col-lg-3">
      <div class="card stat-widget-card border-0 shadow-sm h-100">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-start mb-3">
            <span class="small fw-bold text-uppercase text-theme-muted">Usuarios Registrados</span>
            <div class="stat-icon-wrapper rounded-3 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: rgba(124, 58, 237, 0.15); color: var(--primary-color);">
              <i class="bi bi-people-fill fs-5"></i>
            </div>
          </div>
          <h2 class="display-6 fw-bold mb-1 text-theme-light"><%= totalUsers %></h2>
          <span class="small text-theme-muted">Total en plataforma</span>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card stat-widget-card border-0 shadow-sm h-100">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-start mb-3">
            <span class="small fw-bold text-uppercase text-theme-muted">Sorteos Activos</span>
            <div class="stat-icon-wrapper rounded-3 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: rgba(16, 185, 129, 0.15); color: #10b981;">
              <i class="bi bi-trophy-fill fs-5"></i>
            </div>
          </div>
          <h2 class="display-6 fw-bold mb-1 text-theme-light"><%= activeRaffles %></h2>
          <span class="small text-theme-muted">Visibles para compra</span>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card stat-widget-card border-0 shadow-sm h-100">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-start mb-3">
            <span class="small fw-bold text-uppercase text-theme-muted">Pagos Pendientes</span>
            <div class="stat-icon-wrapper rounded-3 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: rgba(245, 158, 11, 0.15); color: #f59e0b;">
              <i class="bi bi-hourglass-split fs-5"></i>
            </div>
          </div>
          <h2 class="display-6 fw-bold mb-1 text-theme-light"><%= pendingPayments %></h2>
          <span class="small"><a href="/admin/pagos" class="text-decoration-none text-accent fw-bold">Ver y aprobar &rarr;</a></span>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card stat-widget-card border-0 shadow-sm h-100">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-start mb-3">
            <span class="small fw-bold text-uppercase text-theme-muted">Tickets Totales</span>
            <div class="stat-icon-wrapper rounded-3 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: rgba(14, 165, 233, 0.15); color: #0ea5e9;">
              <i class="bi bi-ticket-perforated-fill fs-5"></i>
            </div>
          </div>
          <div class="d-flex justify-content-between align-items-end">
            <div>
              <h3 class="display-6 fw-bold mb-0 text-theme-light"><%= ticketsSold %></h3>
              <span class="small text-theme-muted">Vendidos</span>
            </div>
            <div class="text-end">
              <h3 class="display-6 fw-bold mb-0 text-theme-light"><%= ticketsGifted %></h3>
              <span class="small text-theme-muted">Regalados</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Tickets por Sorteo Activo -->
  <div class="row mb-5">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-transparent pt-4 pb-3 border-0">
          <h5 class="fw-bold mb-0"><i class="bi bi-graph-up-arrow text-primary me-2"></i>Rendimiento por Sorteo Activo</h5>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead>
                <tr>
                  <th class="ps-4">Sorteo</th>
                  <th class="text-center">Tickets Vendidos</th>
                  <th class="text-center">Tickets Regalados</th>
                  <th class="text-end pe-4">Ingresos Brutos (S/)</th>
                </tr>
              </thead>
              <tbody>
                <% if (typeof raffleStats !== 'undefined' && raffleStats.length > 0) { %>
                  <% raffleStats.forEach(stat => { %>
                    <tr>
                      <td class="ps-4 fw-semibold"><%= stat.title %></td>
                      <td class="text-center"><span class="badge bg-primary fs-6 px-3"><%= stat.sold %></span></td>
                      <td class="text-center"><span class="badge bg-secondary fs-6 px-3"><%= stat.gifted %></span></td>
                      <td class="text-end pe-4 text-success fw-bold">S/<%= stat.revenue.toFixed(2) %></td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="4" class="text-center py-4 text-muted">No hay sorteos activos en este momento.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-3 g-md-4 mb-5 row-cols-2 row-cols-md-3 row-cols-lg-6">
    <div class="col">
      <a href="/admin/sorteos" class="card admin-action-card h-100 text-decoration-none p-3 text-center shadow-sm">
        <div class="admin-action-icon rounded-3 mx-auto mb-2" style="background: rgba(124, 58, 237, 0.15); color: var(--primary-color);">
          <i class="bi bi-gift-fill fs-2"></i>
        </div>
        <span class="fw-bold text-theme-light small">Gestionar Sorteos</span>
      </a>
    </div>
    <div class="col">
      <a href="/admin/pagos" class="card admin-action-card h-100 text-decoration-none p-3 text-center shadow-sm">
        <div class="admin-action-icon rounded-3 mx-auto mb-2" style="background: rgba(245, 158, 11, 0.15); color: #f59e0b;">
          <i class="bi bi-cash-coin fs-2"></i>
        </div>
        <span class="fw-bold text-theme-light small">Aprobar Pagos</span>
      </a>
    </div>
    <div class="col">
      <a href="/admin/usuarios" class="card admin-action-card h-100 text-decoration-none p-3 text-center shadow-sm">
        <div class="admin-action-icon rounded-3 mx-auto mb-2" style="background: rgba(16, 185, 129, 0.15); color: #10b981;">
          <i class="bi bi-people-fill fs-2"></i>
        </div>
        <span class="fw-bold text-theme-light small">Gestionar Usuarios</span>
      </a>
    </div>
    <div class="col">
      <a href="/admin/ganadores" class="card admin-action-card h-100 text-decoration-none p-3 text-center shadow-sm">
        <div class="admin-action-icon rounded-3 mx-auto mb-2" style="background: rgba(14, 165, 233, 0.15); color: #0ea5e9;">
          <i class="bi bi-trophy-fill fs-2"></i>
        </div>
        <span class="fw-bold text-theme-light small">Ganadores</span>
      </a>
    </div>
    <div class="col">
      <a href="/admin/businesses" class="card admin-action-card h-100 text-decoration-none p-3 text-center shadow-sm">
        <div class="admin-action-icon rounded-3 mx-auto mb-2" style="background: rgba(236, 72, 153, 0.15); color: var(--secondary-color);">
          <i class="bi bi-shop fs-2"></i>
        </div>
        <span class="fw-bold text-theme-light small">Negocios Aliados</span>
      </a>
    </div>
    <div class="col">
      <a href="/admin/vendedores" class="card admin-action-card h-100 text-decoration-none p-3 text-center shadow-sm">
        <div class="admin-action-icon rounded-3 mx-auto mb-2" style="background: rgba(168, 85, 247, 0.15); color: #a855f7;">
          <i class="bi bi-person-badge fs-2"></i>
        </div>
        <span class="fw-bold text-theme-light small">Vendedores</span>
      </a>
    </div>
  </div>

  <!-- Notificaciones Masivas -->
  <div class="row mb-5">
    <div class="col-12">
      <div class="card border-0 shadow-sm overflow-hidden" style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%);">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="text-white fw-bold mb-0"><i class="bi bi-megaphone-fill me-2"></i>Comunicado Masivo (Push)</h5>
            <button onclick="testPushNotification()" class="btn btn-sm btn-info rounded-pill px-3">
              <i class="bi bi-bell-fill me-1"></i> Probar en mi dispositivo
            </button>
          </div>
          <p class="text-white-50 small mb-4">Envía una notificación a todos los usuarios que hayan aceptado permisos.</p>
          <div class="row g-3">
            <div class="col-md-4">
              <input type="text" id="broadcastTitle" class="form-control text-white" style="background: rgba(255,255,255,0.15) !important; border: 1px solid rgba(255,255,255,0.2) !important;" placeholder="Título (ej: ¡Nuevo Sorteo!)">
            </div>
            <div class="col-md-6">
              <input type="text" id="broadcastBody" class="form-control text-white" style="background: rgba(255,255,255,0.15) !important; border: 1px solid rgba(255,255,255,0.2) !important;" placeholder="Mensaje (ej: Entra ya y participa...)">
            </div>
            <div class="col-md-2">
              <button onclick="sendBroadcast()" class="btn btn-primary w-100 fw-bold">Enviar a Todos</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

<script>
  async function testPushNotification() {
    try {
      const res = await fetch('/push/test', { method: 'POST' });
      const data = await res.json();
      alert(data.message);
    } catch (err) {
      alert('Error enviando notificación');
    }
  }

  async function sendBroadcast() {
    const title = document.getElementById('broadcastTitle').value;
    const body = document.getElementById('broadcastBody').value;
    
    if (!title || !body) return alert('Pon un título y mensaje');

    if (!confirm('¿Estás seguro de enviar esta notificación a TODOS los usuarios?')) return;

    try {
      const res = await fetch('/push/broadcast', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title, body })
      });
      const data = await res.json();
      alert(data.message);
      document.getElementById('broadcastTitle').value = '';
      document.getElementById('broadcastBody').value = '';
    } catch (err) {
      alert('Error en el envío masivo');
    }
  }
</script>
