<%- include('../partials/header') %>

<div class="container py-4">
  <div class="row mb-4 align-items-center">
    <div class="col">
      <h2 class="fw-bold mb-0">Panel de Administración</h2>
    </div>
  </div>

  <div class="row g-4 mb-5">
    <div class="col-md-3">
      <div class="card bg-primary text-white border-0 shadow-sm h-100">
        <div class="card-body">
          <h5 class="card-title">Usuarios Totales</h5>
          <h2 class="display-4 fw-bold mb-0"><%= totalUsers %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-success text-white border-0 shadow-sm h-100">
        <div class="card-body">
          <h5 class="card-title">Sorteos Activos</h5>
          <h2 class="display-4 fw-bold mb-0"><%= activeRaffles %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-warning text-dark border-0 shadow-sm h-100">
        <div class="card-body">
          <h5 class="card-title">Pagos Pendientes</h5>
          <h2 class="display-4 fw-bold mb-0"><%= pendingPayments %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-info text-white border-0 shadow-sm h-100">
        <div class="card-body">
          <h5 class="card-title">Tickets Vendidos</h5>
          <h2 class="display-4 fw-bold mb-0"><%= ticketsSold %></h2>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-md-3">
      <a href="/admin/sorteos" class="btn btn-outline-primary w-100 py-4 d-flex flex-column align-items-center justify-content-center h-100 shadow-sm border-2">
        <i class="bi bi-gift-fill fs-1 mb-2"></i>
        <span class="fw-bold">Gestionar Sorteos</span>
      </a>
    </div>
    <div class="col-md-3">
      <a href="/admin/pagos" class="btn btn-outline-warning text-dark w-100 py-4 d-flex flex-column align-items-center justify-content-center h-100 shadow-sm border-2">
        <i class="bi bi-cash-coin fs-1 mb-2"></i>
        <span class="fw-bold">Aprobar Pagos</span>
      </a>
    </div>
    <div class="col-md-3">
      <a href="/admin/usuarios" class="btn btn-outline-success w-100 py-4 d-flex flex-column align-items-center justify-content-center h-100 shadow-sm border-2">
        <i class="bi bi-people-fill fs-1 mb-2"></i>
        <span class="fw-bold">Gestionar Usuarios</span>
      </a>
    </div>
    <div class="col-md-3">
      <a href="/admin/ganadores" class="btn btn-outline-info text-dark w-100 py-4 d-flex flex-column align-items-center justify-content-center h-100 shadow-sm border-2">
        <i class="bi bi-trophy-fill fs-1 mb-2"></i>
        <span class="fw-bold">Ganadores</span>
      </a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
