<%- include('../partials/header') %>

<style>
  .slot-container {
    position: relative;
    width: 100%;
    max-width: 450px;
    height: 320px;
    margin: 0 auto;
    overflow: hidden;
    border-radius: 1.5rem;
    border: 6px solid #7c3aed;
    box-shadow: 0 15px 40px rgba(124, 58, 237, 0.3);
    background: var(--bg-darker);
    perspective: 1000px;
  }
  
  .slot-container::before,
  .slot-container::after {
    content: '';
    position: absolute;
    left: 0; right: 0;
    height: 120px;
    z-index: 10;
    pointer-events: none;
  }
  .slot-container::before {
    top: 0;
    background: linear-gradient(to bottom, var(--bg-darker) 0%, transparent 100%);
  }
  .slot-container::after {
    bottom: 0;
    background: linear-gradient(to top, var(--bg-darker) 0%, transparent 100%);
  }
  
  .slot-pointer {
    position: absolute;
    top: 50%; left: 0; right: 0;
    height: 70px; margin-top: -35px;
    border-top: 4px solid #f59e0b;
    border-bottom: 4px solid #f59e0b;
    background: rgba(245, 158, 11, 0.1);
    z-index: 15;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  
  .slot-pointer::before {
    content: '▶'; color: #f59e0b; font-size: 1.5rem; margin-left: -15px; text-shadow: 0 0 10px rgba(245,158,11,0.5);
  }
  .slot-pointer::after {
    content: '◀'; color: #f59e0b; font-size: 1.5rem; margin-right: -15px; text-shadow: 0 0 10px rgba(245,158,11,0.5);
  }
  
  .slot-strip {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    transition: transform 0.1s linear;
    will-change: transform;
  }
  
  .slot-item {
    height: 70px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--text-light);
    border-bottom: 1px solid var(--border-color);
    transition: filter 0.3s;
  }
  
  .slot-item .ticket-num {
    font-size: 0.75rem;
    color: #7c3aed;
    background: rgba(124, 58, 237, 0.1);
    padding: 1px 8px;
    border-radius: 10px;
    margin-top: 2px;
  }
  
  .spinning .slot-item {
    filter: blur(1.5px);
  }
  
  .spin-dot { 
    width: 14px; height: 14px; border-radius: 50%; 
    display: inline-block; margin: 0 4px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .spin-dot.done { background: #10b981; transform: scale(1.1); box-shadow: 0 0 10px rgba(16,185,129,0.4); }
  .spin-dot.active { background: #f59e0b; animation: pulse-dot 0.6s infinite alternate; }
  .spin-dot.pending { background: #e5e7eb; }
  @keyframes pulse-dot { from { transform: scale(1); } to { transform: scale(1.4); } }

  .winner-card { display: none; animation: winnerShow 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
  .winner-card.show { display: block; }
  @keyframes winnerShow {
    from { opacity: 0; transform: scale(0.6) translateY(40px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }
</style>

<%
  let initialWinnerName = '';
  let initialWinnerTicket = '';
  let initialWinnerPhone = '';
  let initialWhatsappUrl = '';
  let hasActiveWinner = false;

  if (activeWinner) {
    hasActiveWinner = true;
    initialWinnerName = activeWinner.userId ? activeWinner.userId.name : (activeWinner.guestName || 'Usuario Desconocido');
    initialWinnerPhone = activeWinner.userId ? (activeWinner.userId.phone || 'Sin número') : (activeWinner.guestPhone || 'Sin número');
    initialWinnerTicket = activeWinner.ticketId ? activeWinner.ticketId.ticketNumber : (raffle.winnerTicketId || '');
    if (initialWinnerPhone && initialWinnerPhone !== 'Sin número') {
      const cleanPhone = initialWinnerPhone.replace(/\D/g, '');
      const phoneF = cleanPhone.startsWith('51') ? cleanPhone : '51' + cleanPhone;
      const msg = encodeURIComponent(
        `¡Hola ${initialWinnerName}! 🎉 Te felicitamos de parte de SorteosPeru.pe.\n\n` +
        `¡Has salido GANADOR en el sorteo "${raffle.title}"! 🏆\n` +
        `🎫 Ticket: #${initialWinnerTicket}\n` +
        `💰 Premio: S/${raffle.prizeValue}\n\n` +
        `Por favor confírmanos este mensaje para coordinar la entrega oficial.`
      );
      initialWhatsappUrl = `https://wa.me/${phoneF}?text=${msg}`;
    }
  }
%>

<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-md-10 col-lg-8 text-center">
      <a href="/admin/sorteos" class="text-decoration-none text-muted d-inline-flex align-items-center mb-3">
        <i class="bi bi-arrow-left me-1"></i> Volver a sorteos
      </a>
      
      <div class="d-flex align-items-center justify-content-center gap-2 mb-2 flex-wrap">
        <h2 class="fw-bold mb-0 text-theme-light"><%= raffle.title %></h2>
        <% if (raffle.status === 'completed') { %>
          <span class="badge bg-success px-3 py-2" id="statusBadge">Completado</span>
        <% } else { %>
          <span class="badge bg-warning text-dark px-3 py-2" id="statusBadge">En Vivo / Activo</span>
        <% } %>
      </div>

      <p class="text-muted fs-5 mb-1">Premio Oficial: <strong class="text-success">S/<%= raffle.prizeValue %></strong></p>
      <p class="text-muted mb-4">
        <strong id="ticketCountText"><%= tickets.length %></strong> tickets válidos disponibles para sortear
      </p>

      <!-- CONFIGURACIÓN DE SUSPENSO (Sólo cuando ruleta activa) -->
      <div class="card border-0 shadow-sm mb-4" id="configCard" style="<%= hasActiveWinner ? 'display: none;' : '' %>">
        <div class="card-body p-4">
          <h5 class="fw-bold mb-3"><i class="bi bi-stars text-warning me-2"></i>Preparar el Momento</h5>
          <label class="form-label text-muted small fw-bold">Número de giros previos (Suspenso en vivo)</label>
          <div class="d-flex align-items-center gap-2 justify-content-center flex-wrap">
            <div class="btn-group shadow-sm">
              <button type="button" class="btn btn-outline-primary px-3" onclick="setTotalSpins(3)">3</button>
              <button type="button" class="btn btn-primary px-3" onclick="setTotalSpins(5)">5</button>
              <button type="button" class="btn btn-outline-primary px-3" onclick="setTotalSpins(7)">7</button>
              <button type="button" class="btn btn-outline-primary px-3" onclick="setTotalSpins(10)">10</button>
            </div>
            <span class="mx-2 text-muted fw-bold">Ó</span>
            <input type="number" class="form-control" id="customSpins" style="width: 80px;" min="1" max="50" value="5" onchange="setTotalSpins(parseInt(this.value))">
          </div>
          <p class="text-muted small mt-3 mb-0">El ganador definitivo aparecerá en el giro #<strong id="totalSpinsText" class="text-primary">5</strong>.</p>
        </div>
      </div>

      <!-- RULETA INTERACTIVA -->
      <div class="card border-0 shadow-lg p-4 p-md-5 mb-4" id="rouletteCard" style="<%= hasActiveWinner ? 'display: none;' : '' %>">
        <div class="mb-4" id="spinTracker">
          <h5 class="fw-bold mb-3">Giro <span id="currentSpinNum" class="text-primary">0</span> de <span id="totalSpinNum">5</span></h5>
          <div id="spinDots" class="d-flex justify-content-center flex-wrap gap-1"></div>
        </div>

        <div class="slot-container mb-4" id="slotContainer" 
             data-tickets='<%- JSON.stringify(tickets.map(t => ({ number: t.ticketNumber, name: t.userId ? t.userId.name : (t.guestName || "Invitado") }))) %>'
             data-raffle-id="<%= raffle._id %>">
          <div class="slot-pointer"></div>
          <div class="slot-strip" id="slotStrip"></div>
        </div>

        <div id="controls">
          <button class="btn btn-danger btn-lg w-100 py-3 fs-5 fw-bold shadow" id="spinBtn" <%= tickets.length === 0 ? 'disabled' : '' %>>
            <i class="bi bi-play-fill me-2"></i> <span id="spinBtnText">GIRAR (Giro 1)</span>
          </button>
        </div>
      </div>

      <!-- GANADOR OFICIAL ACTUAL -->
      <div class="card border-0 shadow-lg p-4 p-md-5 mb-4 winner-card <%= hasActiveWinner ? 'show' : '' %>" id="winnerCard">
        <div class="winner-trophy mb-3" style="font-size: 5.5rem; filter: drop-shadow(0 10px 15px rgba(0,0,0,0.15));">🏆</div>
        <h2 class="fw-bold mb-1">¡Ganador Seleccionado!</h2>
        <p class="text-muted mb-4">El sorteo arrojó el siguiente resultado oficial:</p>
        
        <div class="bg-primary bg-opacity-10 border border-primary border-opacity-25 p-4 rounded-4 mb-4">
          <h1 class="fw-bold text-primary mb-2" id="winnerName" style="font-size: 2.2rem;">
            <%= initialWinnerName %>
          </h1>
          <div class="d-flex justify-content-center gap-2 mb-3">
            <span class="badge bg-primary fs-5 px-3 py-2" id="winnerTicket">
              Ticket: <%= initialWinnerTicket %>
            </span>
          </div>
          <h4 class="fw-bold text-theme-light mb-3" id="winnerPrize">
            Premio: S/<%= raffle.prizeValue %>
          </h4>

          <!-- CONTACTO DIRECTO / WHATSAPP -->
          <div class="p-3 rounded-3 mt-2" style="background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.3);">
            <div class="d-flex align-items-center justify-content-center gap-3 flex-wrap">
              <span class="fw-bold text-success fs-5">
                <i class="bi bi-telephone-fill me-1"></i> <span id="winnerPhone"><%= initialWinnerPhone || 'Sin número' %></span>
              </span>
              <a href="<%= initialWhatsappUrl || '#' %>" target="_blank" id="winnerWhatsappBtn" class="btn btn-success fw-bold px-3 py-2 rounded-pill shadow-sm <%= initialWhatsappUrl ? '' : 'd-none' %>">
                <i class="bi bi-whatsapp me-1"></i> Llamar / Chat WhatsApp
              </a>
            </div>
            <small class="text-muted d-block mt-2">
              <i class="bi bi-shield-check me-1"></i> Comunícate con el ganador para validar su identidad y entrega de premio.
            </small>
          </div>
        </div>
        
        <!-- ACCIONES Y RE-SORTEO -->
        <div class="row g-2">
          <div class="col-md-6">
            <a href="/admin/ganadores" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold">
              <i class="bi bi-trophy me-1"></i> Ver en Ganadores
            </a>
          </div>
          <div class="col-md-6">
            <button type="button" class="btn btn-outline-danger btn-lg w-100 rounded-pill fw-bold" onclick="openDisqualifyModal()">
              <i class="bi bi-arrow-repeat me-1"></i> Anular y Volver a Sortear
            </button>
          </div>
        </div>
      </div>

      <!-- HISTORIAL DE INTENTOS Y RESPALDO DE AUDITORÍA -->
      <div class="card border-0 shadow-sm text-start mb-4">
        <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
          <h5 class="fw-bold mb-0">
            <i class="bi bi-shield-lock-fill text-primary me-2"></i>Historial de Intentos y Respaldo
          </h5>
          <span class="badge bg-secondary" id="attemptCountBadge">
            <%= (attempts && attempts.length > 0) ? attempts.length : 0 %> intentos registrados
          </span>
        </div>
        <div class="card-body p-4">
          <p class="text-muted small mb-3">
            Cada giro ganador queda respaldado con fecha, hora y motivo. Si un ganador no contesta o no califica, puedes anularlo sin borrar ni perder ningún otro ticket de la base de datos.
          </p>

          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="attemptsTable">
              <thead class="table-light">
                <tr>
                  <th>Intento</th>
                  <th>Ticket</th>
                  <th>Participante</th>
                  <th>Teléfono</th>
                  <th>Estado</th>
                  <th>Fecha</th>
                </tr>
              </thead>
              <tbody id="attemptsTableBody">
                <% if (attempts && attempts.length > 0) { %>
                  <% attempts.forEach(att => { %>
                    <tr>
                      <td class="fw-bold">#<%= att.attemptNumber %></td>
                      <td><span class="badge bg-primary"><%= att.ticketNumber %></span></td>
                      <td class="fw-semibold"><%= att.winnerName %></td>
                      <td>
                        <% if (att.winnerPhone && att.winnerPhone !== 'Sin número') { %>
                          <% 
                            const cl = att.winnerPhone.replace(/\D/g, '');
                            const pf = cl.startsWith('51') ? cl : '51' + cl;
                          %>
                          <a href="https://wa.me/<%= pf %>" target="_blank" class="text-decoration-none text-success fw-bold">
                            <i class="bi bi-whatsapp me-1"></i><%= att.winnerPhone %>
                          </a>
                        <% } else { %>
                          <span class="text-muted">Sin teléfono</span>
                        <% } %>
                      </td>
                      <td>
                        <% if (att.status === 'disqualified') { %>
                          <span class="badge bg-danger">Anulado</span>
                          <div class="small text-danger mt-1"><%= att.disqualifiedReason || 'Descalificado' %></div>
                        <% } else { %>
                          <span class="badge bg-success">Ganador Oficial</span>
                        <% } %>
                      </td>
                      <td class="small text-muted">
                        <%= new Date(att.drawnAt).toLocaleTimeString('es-PE', { hour: '2-digit', minute: '2-digit', second: '2-digit' }) %>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr id="noAttemptsRow">
                    <td colspan="6" class="text-center py-4 text-muted">
                      No se han realizado giros para este sorteo todavía.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- MODAL: ANULAR GANADOR Y REPETIR SORTEO -->
<div class="modal fade" id="disqualifyModal" tabindex="-1" aria-labelledby="disqualifyModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg" style="background: var(--bg-card); color: var(--text-light);">
      <div class="modal-header bg-danger text-white border-0">
        <h5 class="modal-title fw-bold" id="disqualifyModalLabel">
          <i class="bi bi-exclamation-triangle-fill me-2"></i>Anular Ganador y Volver a Sortear
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4 text-start">
        <div class="alert alert-warning border-0 small mb-3">
          <i class="bi bi-shield-check me-1"></i> <strong>Respaldo de Base de Datos Seguro:</strong> 
          El ticket actual será marcado como descalificado con tu motivo. Ningún otro ticket será borrado y podrás girar la ruleta nuevamente con los tickets válidos restantes.
        </div>

        <div class="mb-3">
          <label class="form-label text-muted small fw-bold">Selecciona un motivo común:</label>
          <select class="form-select" id="predefinedReasonSelect" onchange="onSelectReason(this.value)">
            <option value="">-- Seleccionar motivo --</option>
            <option value="No contestó las 3 llamadas en vivo reglamentarias">No contestó las 3 llamadas en vivo reglamentarias</option>
            <option value="No tiene número de teléfono registrado">No tiene número de teléfono registrado</option>
            <option value="Número telefónico fuera de servicio / apagado">Número telefónico fuera de servicio / apagado</option>
            <option value="Número de teléfono equivocado o ajeno al comprador">Número de teléfono equivocado o ajeno</option>
            <option value="Comprobante de pago inválido o no presentó sustento">Comprobante inválido o sin sustento</option>
            <option value="Incumplimiento de términos y condiciones del sorteo">Incumplimiento de términos y condiciones</option>
          </select>
        </div>

        <div class="mb-3">
          <label class="form-label text-muted small fw-bold">Detalle o motivo específico:</label>
          <textarea class="form-control" id="disqualifyReasonInput" rows="3" placeholder="Ej: Se realizaron 3 llamadas en vivo y no hubo respuesta."></textarea>
        </div>
      </div>
      <div class="modal-footer border-0 pt-0">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-danger fw-bold px-4" id="btnConfirmDisqualify" onclick="confirmDisqualification()">
          <i class="bi bi-arrow-repeat me-1"></i> Confirmar y Reabrir Sorteo
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Socket.io y Canvas Confetti -->
<script src="/socket.io/socket.io.js"></script>
<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

<script>
  const socket = io();
  const container = document.getElementById('slotContainer');
  let ticketsData = JSON.parse(container.dataset.tickets || '[]');
  const raffleId = container.dataset.raffleId;
  const slotStrip = document.getElementById('slotStrip');
  const spinBtn = document.getElementById('spinBtn');
  const winnerCard = document.getElementById('winnerCard');
  const rouletteCard = document.getElementById('rouletteCard');
  const configCard = document.getElementById('configCard');
  const itemHeight = 70;
  const visibleItems = 150;

  let totalSpins = 5;
  let currentSpin = 0;
  let isSpinning = false;
  let winnerData = null;

  // Generar tira de participantes
  function buildStrip(winner = null) {
    slotStrip.innerHTML = '';
    const stripItems = [];
    
    if (ticketsData.length === 0) {
      stripItems.push({ name: 'Sin tickets válidos', number: '000000' });
    } else {
      const uniqueMap = {};
      ticketsData.forEach(t => {
        if (!uniqueMap[t.name]) uniqueMap[t.name] = t;
      });
      const uniqueParticipants = Object.values(uniqueMap);
      
      for (let i = 0; i < visibleItems; i++) {
        const shuffled = [...uniqueParticipants].sort(() => Math.random() - 0.5);
        stripItems.push(shuffled[i % shuffled.length]);
      }

      for (let i = stripItems.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [stripItems[i], stripItems[j]] = [stripItems[j], stripItems[i]];
      }

      for (let i = 1; i < stripItems.length; i++) {
        if (stripItems[i].name === stripItems[i-1].name) {
          for (let j = i + 1; j < stripItems.length; j++) {
            if (stripItems[j].name !== stripItems[i-1].name) {
              [stripItems[i], stripItems[j]] = [stripItems[j], stripItems[i]];
              break;
            }
          }
        }
      }
    }

    if (winner) {
      const landingIndex = visibleItems - 10;
      stripItems[landingIndex] = { name: winner.name, number: winner.ticketNumber };
      winner.landingIndex = landingIndex;
    }

    stripItems.forEach(item => {
      const div = document.createElement('div');
      div.className = 'slot-item';
      div.innerHTML = `<div>${item.name}</div><div class="ticket-num">${item.number}</div>`;
      slotStrip.appendChild(div);
    });

    return stripItems;
  }

  buildStrip();

  function setTotalSpins(n) {
    if (isSpinning) return;
    totalSpins = Math.max(1, Math.min(50, n));
    document.getElementById('customSpins').value = totalSpins;
    document.getElementById('totalSpinsText').textContent = totalSpins;
    updateSpinUI();
  }

  function updateSpinUI() {
    document.getElementById('currentSpinNum').textContent = currentSpin;
    document.getElementById('totalSpinNum').textContent = totalSpins;

    let dotsHtml = '';
    for (let d = 1; d <= totalSpins; d++) {
      const cls = d <= currentSpin ? 'done' : (d === currentSpin + 1 ? 'active' : 'pending');
      dotsHtml += `<div class="spin-dot ${cls}"></div>`;
    }
    document.getElementById('spinDots').innerHTML = dotsHtml;

    const nextSpin = currentSpin + 1;
    if (nextSpin > totalSpins) {
      spinBtn.classList.add('d-none');
    } else {
      const isFinal = nextSpin === totalSpins;
      document.getElementById('spinBtnText').innerHTML = isFinal ? `🏆 GIRO FINAL (${nextSpin}/${totalSpins})` : `GIRAR (Giro ${nextSpin}/${totalSpins})`;
      spinBtn.className = isFinal ? 'btn btn-warning btn-lg w-100 py-3 fs-5 fw-bold shadow' : 'btn btn-danger btn-lg w-100 py-3 fs-5 fw-bold shadow';
    }
  }

  updateSpinUI();

  spinBtn.addEventListener('click', async () => {
    if (isSpinning || currentSpin >= totalSpins) return;
    
    isSpinning = true;
    currentSpin++;
    spinBtn.disabled = true;
    container.classList.add('spinning');
    
    if (currentSpin === 1) configCard.style.opacity = '0.3';

    const isFinal = currentSpin === totalSpins;
    
    if (isFinal) {
      try {
        const res = await fetch(`/admin/sorteos/${raffleId}/ejecutar`, { method: 'POST' });
        const data = await res.json();
        if (!data.success) throw new Error(data.error);
        winnerData = data.winner;
        runSpin(true);
      } catch (err) {
        alert(err.message || 'Error al conectar');
        isSpinning = false;
        spinBtn.disabled = false;
        currentSpin--;
      }
    } else {
      runSpin(false);
    }
  });

  function runSpin(isFinal) {
    const strip = buildStrip(isFinal ? winnerData : null);
    
    const isPenultimate = currentSpin === totalSpins - 1;
    let duration = 2000;
    if (isPenultimate) duration = 6000;
    if (isFinal) duration = 10000;
    
    slotStrip.style.transition = 'none';
    slotStrip.style.transform = 'translateY(0)';
    slotStrip.offsetHeight; // Reflow

    let targetIndex;
    if (isFinal) {
      targetIndex = winnerData.landingIndex;
      socket.emit('admin_spin_final', { raffleId, currentSpin, totalSpins, winner: winnerData, stripItems: strip, targetIndex });
    } else {
      targetIndex = visibleItems - 15 + Math.floor(Math.random() * 10);
      socket.emit('admin_spin', { raffleId, currentSpin, totalSpins, isFinal: false, stripItems: strip, targetIndex });
    }

    const containerHeight = container.offsetHeight;
    const offset = (targetIndex * itemHeight) - (containerHeight / 2) + (itemHeight / 2);

    slotStrip.style.transition = `transform ${duration}ms cubic-bezier(0.15, 0, 0.15, 1)`;
    slotStrip.style.transform = `translateY(-${offset}px)`;

    setTimeout(() => {
      isSpinning = false;
      container.classList.remove('spinning');
      updateSpinUI();
      
      if (isFinal) {
        launchEffects();
      } else {
        spinBtn.disabled = false;
      }
    }, duration + 200);
  }

  function launchEffects() {
    confetti({
      particleCount: 160,
      spread: 80,
      origin: { y: 0.6 },
      colors: ['#7c3aed', '#f59e0b', '#10b981']
    });

    setTimeout(() => {
      document.getElementById('winnerName').textContent = winnerData.name;
      document.getElementById('winnerTicket').textContent = `Ticket: ${winnerData.ticketNumber}`;
      document.getElementById('winnerPrize').textContent = `Premio: S/${winnerData.prize}`;
      document.getElementById('winnerPhone').textContent = winnerData.phone || 'Sin número';

      const waBtn = document.getElementById('winnerWhatsappBtn');
      if (winnerData.whatsappUrl) {
        waBtn.href = winnerData.whatsappUrl;
        waBtn.classList.remove('d-none');
      } else {
        waBtn.classList.add('d-none');
      }

      winnerCard.classList.add('show');
      rouletteCard.style.display = 'none';
      configCard.style.display = 'none';
      document.getElementById('statusBadge').className = 'badge bg-success px-3 py-2';
      document.getElementById('statusBadge').textContent = 'Completado';

      // Añadir fila al historial de auditoría
      const noRow = document.getElementById('noAttemptsRow');
      if (noRow) noRow.remove();

      const tbody = document.getElementById('attemptsTableBody');
      const tr = document.createElement('tr');
      const timeStr = new Date().toLocaleTimeString('es-PE', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
      
      let waLinkHtml = '<span class="text-muted">Sin teléfono</span>';
      if (winnerData.phone && winnerData.phone !== 'Sin número') {
        const cl = winnerData.phone.replace(/\D/g, '');
        const pf = cl.startsWith('51') ? cl : '51' + cl;
        waLinkHtml = `<a href="https://wa.me/${pf}" target="_blank" class="text-decoration-none text-success fw-bold"><i class="bi bi-whatsapp me-1"></i>${winnerData.phone}</a>`;
      }

      tr.innerHTML = `
        <td class="fw-bold">#${winnerData.attemptNumber || 1}</td>
        <td><span class="badge bg-primary">${winnerData.ticketNumber}</span></td>
        <td class="fw-semibold">${winnerData.name}</td>
        <td>${waLinkHtml}</td>
        <td><span class="badge bg-success">Ganador Oficial</span></td>
        <td class="small text-muted">${timeStr}</td>
      `;
      tbody.prepend(tr);

      const countBadge = document.getElementById('attemptCountBadge');
      if (countBadge) {
        const curCount = parseInt(countBadge.textContent) || 0;
        countBadge.textContent = `${curCount + 1} intentos registrados`;
      }
    }, 1000);
  }

  // Lógica de Anulación y Re-Sorteo
  function openDisqualifyModal() {
    const modalEl = document.getElementById('disqualifyModal');
    const modal = new bootstrap.Modal(modalEl);
    modal.show();
  }

  function onSelectReason(val) {
    if (val) {
      document.getElementById('disqualifyReasonInput').value = val;
    }
  }

  async function confirmDisqualification() {
    const reasonInput = document.getElementById('disqualifyReasonInput');
    const reason = reasonInput.value.trim();
    if (!reason) {
      alert('Por favor indica un motivo de anulación para el registro de respaldo.');
      return;
    }

    const btn = document.getElementById('btnConfirmDisqualify');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Anulando...';

    try {
      const res = await fetch(`/admin/sorteos/${raffleId}/anular-ganador`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reason })
      });
      const data = await res.json();
      if (!data.success) throw new Error(data.error);

      // Cerrar modal
      const modalEl = document.getElementById('disqualifyModal');
      const modal = bootstrap.Modal.getInstance(modalEl);
      if (modal) modal.hide();

      alert('✅ ' + data.message);
      // Recargar para reiniciar la ruleta limpia con todos los tickets restantes
      window.location.reload();
    } catch (err) {
      alert(err.message || 'Error al anular ganador');
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i> Confirmar y Reabrir Sorteo';
    }
  }
</script>

