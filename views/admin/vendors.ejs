<%- include('../partials/header') %>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">Gestión de Vendedores</h2>
        <button class="btn btn-primary fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#createModal">
            <i class="bi bi-plus-lg me-1"></i> Nuevo Vendedor
        </button>
    </div>

    <% if (typeof success !== 'undefined' || (locals.query && locals.query.success)) { %>
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            <%= typeof success !== 'undefined' ? success : locals.query.success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <!-- Tabla de Vendedores -->
    <div class="card bg-theme-card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background: rgba(0,0,0,0.1);">
                        <tr class="text-theme-muted">
                            <th class="ps-4 py-3">Vendedor</th>
                            <th class="py-3">Contacto</th>
                            <th class="py-3">Código / Comisión</th>
                            <th class="py-3 text-center">Ventas Aprobadas</th>
                            <th class="py-3 text-center">Ventas Pendientes</th>
                            <th class="py-3 text-end text-primary">Recaudado (Efectivo)</th>
                            <th class="py-3 text-end">Comisión Ganada</th>
                            <th class="pe-4 py-3 text-end text-danger fw-bold">Monto a Rendir</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (vendors && vendors.length > 0) { %>
                            <% vendors.forEach(v => { %>
                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="fw-bold text-theme-light"><%= v.name %></div>
                                        <div class="small text-theme-muted">Reg: <%= new Date(v.createdAt).toLocaleDateString() %></div>
                                    </td>
                                    <td class="py-3">
                                        <div class="text-theme-light"><%= v.email %></div>
                                        <div class="small text-muted"><i class="bi bi-whatsapp text-success me-1"></i><%= v.phone %></div>
                                    </td>
                                    <td class="py-3">
                                        <div class="fw-bold text-primary" style="font-family: monospace;"><%= v.vendorCode %></div>
                                        <div class="small text-muted">Comisión: <%= v.commissionRate %>%</div>
                                    </td>
                                    <td class="py-3 text-center">
                                        <span class="badge bg-success rounded-pill px-3 py-2"><%= v.approvedSalesCount %></span>
                                    </td>
                                    <td class="py-3 text-center">
                                        <% if (v.pendingSalesCount > 0) { %>
                                            <span class="badge bg-warning text-dark rounded-pill px-3 py-2"><%= v.pendingSalesCount %></span>
                                        <% } else { %>
                                            <span class="text-muted">0</span>
                                        <% } %>
                                    </td>
                                    <td class="py-3 text-end text-primary fw-medium">
                                        S/ <%= (v.amountCollectedByVendor || 0).toFixed(2) %>
                                    </td>
                                    <td class="py-3 text-end fw-bold text-success">
                                        S/ <%= (v.estimatedCommission || 0).toFixed(2) %>
                                    </td>
                                    <td class="pe-4 py-3 text-end fw-bold text-danger">
                                        S/ <%= (v.amountToRemitToAdmin || 0).toFixed(2) %>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="py-5 text-center text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                                    No hay vendedores registrados.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Nuevo Vendedor -->
<div class="modal fade" id="createModal" tabindex="-1" aria-labelledby="createModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light border-0">
                <h5 class="modal-title fw-bold" id="createModalLabel">Crear Nuevo Vendedor</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form action="/admin/vendedores" method="POST">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nombre Completo</label>
                        <input type="text" name="name" required class="form-control" placeholder="Ej. Juan Pérez">
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Correo Electrónico</label>
                        <input type="email" name="email" required class="form-control" placeholder="juan@ejemplo.com">
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Teléfono</label>
                        <input type="text" name="phone" required class="form-control" placeholder="987654321">
                    </div>

                    <div class="row mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Código Único</label>
                            <input type="text" name="vendorCode" required class="form-control font-monospace" placeholder="Ej. VEND-001">
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Comisión (%)</label>
                            <input type="number" name="commissionRate" required min="0" max="100" value="10" class="form-control">
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Contraseña Temporal</label>
                        <input type="password" name="password" required class="form-control" placeholder="******">
                    </div>
                    
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary fw-bold py-2">
                            Crear Vendedor
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
