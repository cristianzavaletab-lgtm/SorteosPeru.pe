<%- include('../partials/header') %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold mb-0">Gestionar Usuarios</h2>
      <p class="text-muted small mb-0">Lista de personas registradas y sus participaciones.</p>
    </div>
    <div class="d-flex gap-2 align-items-center">
      <form action="/admin/usuarios" method="GET" class="d-flex gap-2 align-items-center me-2">
        <select name="raffleId" class="form-select form-select-sm" onchange="this.form.submit()" style="min-width: 200px;">
          <option value="">Todos los sorteos</option>
          <% if (locals.allRaffles && locals.allRaffles.length > 0) { %>
            <% allRaffles.forEach(r => { %>
              <option value="<%= r._id %>" <%= locals.selectedRaffleId == r._id ? 'selected' : '' %>>
                <%= r.title %>
              </option>
            <% }) %>
          <% } %>
        </select>
      </form>
      <a href="/admin/usuarios/exportar<%= locals.selectedRaffleId ? '?raffleId=' + selectedRaffleId : '' %>" class="btn btn-success">
        <i class="bi bi-file-earmark-excel me-2"></i>Exportar Excel
      </a>
      <a href="/admin" class="btn btn-outline-secondary">Volver al Panel</a>
    </div>
  </div>

  <% if (users && users.length > 0) { %>
    <div class="card border-0 shadow-sm overflow-hidden">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="bg-light">
            <tr>
              <th class="px-4 py-3 border-0">Nombre</th>
              <th class="py-3 border-0">Email / Teléfono</th>
              <th class="py-3 border-0 text-center">Tickets</th>
              <th class="py-3 border-0">Registro</th>
              <th class="py-3 border-0 text-end px-4">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(user => { %>
              <tr>
                <td class="px-4">
                  <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                      <i class="bi bi-person-fill fs-5"></i>
                    </div>
                    <span class="fw-bold"><%= user.name %></span>
                  </div>
                </td>
                <td>
                  <div class="small fw-semibold"><%= user.email %></div>
                  <div class="text-muted small"><%= user.phone %></div>
                </td>
                <td class="text-center">
                  <span class="badge rounded-pill bg-<%= user.ticketCount > 0 ? 'primary' : 'secondary' %>">
                    <%= user.ticketCount %> ticket<%= user.ticketCount !== 1 ? 's' : '' %>
                  </span>
                </td>
                <td class="small text-muted">
                  <%= user.createdAt.toLocaleDateString('es-PE') %>
                </td>
                <td class="text-end px-4">
                  <% 
                    let isCompleted = false;
                    if (locals.selectedRaffleId && locals.allRaffles) {
                      const selR = allRaffles.find(r => r._id == selectedRaffleId);
                      if (selR && selR.status === 'completed') isCompleted = true;
                    }
                  %>
                  <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" 
                          onclick="openGiftModal('<%= user._id %>', '<%= user.name %>')"
                          <%= isCompleted ? 'disabled' : '' %>>
                    <i class="bi bi-gift me-1"></i> Regalar
                  </button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } else { %>
    <div class="text-center py-5 bg-white rounded-4 shadow-sm">
      <i class="bi bi-people fs-1 text-muted mb-3 d-block"></i>
      <p class="text-muted">No hay usuarios registrados todavía.</p>
    </div>
  <% } %>
</div>

<!-- Modal para Regalar Tickets -->
<div class="modal fade" id="giftModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold">🎁 Regalar Tickets</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="giftForm" method="POST">
        <div class="modal-body py-4">
          <p class="text-muted small mb-4">Otorgar tickets gratuitos a <strong id="modalUserName" class="text-dark"></strong>.</p>
          
          <div class="mb-3">
            <label class="form-label small fw-bold">Seleccionar Sorteo</label>
            <select class="form-select bg-light border-0" name="raffleId" required>
              <option value="">Seleccione un sorteo activo...</option>
              <% if (locals.activeRaffles && locals.activeRaffles.length > 0) { %>
                <% locals.activeRaffles.forEach(raffle => { %>
                  <option value="<%= raffle._id %>"><%= raffle.title %> (S/<%= raffle.ticketPrice %>)</option>
                <% }) %>
              <% } %>
            </select>
          </div>
          
          <div class="mb-0">
            <label class="form-label small fw-bold">Cantidad de Tickets</label>
            <input type="number" class="form-control bg-light border-0" name="qty" min="1" max="100" value="1" required>
          </div>
        </div>
        <div class="modal-footer border-0 pt-0">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary px-4">Confirmar y Entregar</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function openGiftModal(userId, userName) {
    const modal = new bootstrap.Modal(document.getElementById('giftModal'));
    document.getElementById('modalUserName').textContent = userName;
    document.getElementById('giftForm').action = `/admin/usuarios/${userId}/regalar-tickets`;
    modal.show();
  }
</script>

<%- include('../partials/footer') %>
