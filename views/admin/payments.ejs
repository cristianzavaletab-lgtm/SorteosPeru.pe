<%- include('../partials/header') %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">Pagos Pendientes</h2>
    <a href="/admin" class="btn btn-outline-secondary">Volver al Panel</a>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead>
            <tr>
              <th class="px-4 py-3">Fecha</th>
              <th class="py-3">Usuario</th>
              <th class="py-3">Sorteo</th>
              <th class="py-3">Monto</th>
              <th class="py-3">Método</th>
              <th class="py-3">Comprobante</th>
              <th class="px-4 py-3 text-end">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% if (payments && payments.length > 0) { %>
              <% for (const payment of payments) { %>
                <tr>
                  <td class="px-4 py-3 align-middle"><%= payment.createdAt.toLocaleDateString() %></td>
                  <td class="py-3 align-middle">
                    <% if (payment.userId) { %>
                      <div class="fw-bold"><%= payment.userId.name %></div>
                      <div class="small text-muted"><%= payment.userId.phone %></div>
                    <% } else if (payment.guestName) { %>
                      <div class="fw-bold"><%= payment.guestName %> <span class="badge bg-secondary ms-1">Invitado</span></div>
                      <div class="small text-muted"><%= payment.guestPhone %></div>
                    <% } else { %>
                      <div class="fw-bold">N/A</div>
                    <% } %>
                    
                    <% if (payment.vendorId) { %>
                      <div class="mt-1 small"><span class="badge bg-dark"><i class="bi bi-person-badge me-1"></i>Vendedor</span></div>
                    <% } %>
                  </td>
                  <td class="py-3 align-middle"><%= payment.raffleId ? payment.raffleId.title : 'Sorteo Eliminado' %></td>
                  <td class="py-3 align-middle fw-bold text-success">
                    S/<%= payment.amount ? payment.amount.toFixed(2) : '0.00' %>
                    <% if (payment.ticketQty > 1) { %>
                      <span class="badge bg-primary ms-1"><%= payment.ticketQty %> tickets</span>
                    <% } %>
                  </td>
                  <td class="py-3 align-middle">
                    <% 
                      const isYape = payment.paymentMethod === 'yape';
                      const isPlin = payment.paymentMethod === 'plin';
                      const isCash = payment.paymentMethod === 'cash';
                      let badgeClass = 'bg-info';
                      let badgeStyle = '';
                      if (isYape) { badgeClass = 'bg-purple'; badgeStyle = 'background-color: #742284;'; }
                      else if (isPlin) { badgeClass = 'bg-info'; }
                      else if (isCash) { badgeClass = 'bg-success'; }
                    %>
                    <span class="badge <%= badgeClass %> mb-1" style="<%= badgeStyle %>">
                      <%= (payment.paymentMethod || 'N/A').toUpperCase() %>
                    </span>
                    <% if (payment.paymentDestination === 'vendor') { %>
                      <div class="small text-muted"><i class="bi bi-person-bounding-box me-1"></i>Pagó al Vendedor</div>
                    <% } else { %>
                      <div class="small text-muted"><i class="bi bi-bank me-1"></i>Cuenta Oficial</div>
                    <% } %>
                  </td>
                  <td class="py-3 align-middle">
                    <% if (payment.receiptImage) { %>
                      <a href="/uploads/<%= payment.receiptImage %>" target="_blank" class="btn btn-sm btn-outline-primary">Ver Imagen</a>
                    <% } else if (payment.paymentDestination === 'vendor') { %>
                      <span class="text-warning small"><i class="bi bi-exclamation-triangle me-1"></i>Pendiente rendición</span>
                    <% } else { %>
                      <span class="text-muted small">Sin imagen</span>
                    <% } %>
                  </td>
                  <td class="px-4 py-3 align-middle text-end">
                    <div class="d-flex justify-content-end gap-2">
                      <form action="/admin/pagos/<%= payment._id %>/aprobar" method="POST" class="m-0">
                        <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-check-lg"></i> Aprobar</button>
                      </form>
                      <form action="/admin/pagos/<%= payment._id %>/rechazar" method="POST" class="m-0">
                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('¿Seguro que deseas rechazar este pago?')"><i class="bi bi-x-lg"></i> Rechazar</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% } %>
            <% } else { %>
              <tr>
                <td colspan="7" class="text-center py-5 text-muted">No hay pagos pendientes de aprobación.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
