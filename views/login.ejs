<%- include('partials/header') %>

<!-- Google Identity Services SDK -->
<script src="https://accounts.google.com/gsi/client" async defer></script>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card shadow p-4 p-md-5 border-0">
        <div class="text-center mb-4">
          <img src="/images/logo-conejo.png" alt="Sorteos Perú" style="width: 70px; height: 70px; object-fit: contain; margin-bottom: 0.75rem; filter: drop-shadow(0 4px 8px rgba(0,0,0,0.2));">
          <h2 class="fw-bold" style="color: var(--secondary-color);">Bienvenido de vuelta</h2>
          <p class="text-muted text-center">Ingresa a tu cuenta para participar</p>
        </div>

        <% if (locals.error) { %>
          <div class="alert alert-danger border-0 small py-2 text-center mb-4 rounded-3">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
          </div>
        <% } %>

        <% if (locals.success) { %>
          <div class="alert alert-success border-0 small py-2 text-center mb-4 rounded-3" style="background: rgba(16, 185, 129, 0.15); color: #10b981;">
            <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
          </div>
        <% } %>
        
        <!-- Google Sign-In (Un solo botón elegante) -->
        <div class="mb-4">
          <div id="g_id_signin" class="d-flex justify-content-center mb-1" style="min-height: 44px;"></div>
          
          <!-- Botón de respaldo (oculto por defecto para no duplicarse nunca) -->
          <button type="button" class="btn btn-outline-secondary w-100 py-2 align-items-center justify-content-center gap-2 rounded-pill shadow-sm border" id="googleCustomBtn" style="font-weight: 500; font-size: 0.95rem; display: none;">
            <svg width="20" height="20" viewBox="0 0 48 48">
              <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
              <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
              <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
              <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
            </svg>
            Continuar con Google
          </button>

          <div class="d-flex align-items-center my-3">
            <hr class="flex-grow-1 border-secondary border-opacity-25 my-0">
            <span class="px-3 text-muted small fw-medium">o con tu correo</span>
            <hr class="flex-grow-1 border-secondary border-opacity-25 my-0">
          </div>
        </div>

        <form action="/auth/login" method="POST">
          <div class="mb-3">
            <label class="form-label text-muted small fw-bold">Correo Electrónico</label>
            <input type="email" class="form-control form-control-lg" name="email" required placeholder="tu@correo.com">
          </div>
          <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <label class="form-label text-muted small fw-bold mb-0">Contraseña</label>
              <a href="/forgot-password" class="small text-accent text-decoration-none" style="color: var(--accent-color); font-size: 0.8rem;">¿Olvidaste tu contraseña?</a>
            </div>
            <div class="input-group">
              <input type="password" class="form-control form-control-lg" name="password" id="passwordInput" required placeholder="••••••••">
              <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                <i class="bi bi-eye-fill text-muted"></i>
              </button>
            </div>
          </div>
          <button type="submit" class="btn btn-primary btn-lg w-100 mb-3 fw-bold">Ingresar</button>
        </form>
        
        <div class="text-center mt-3">
          <p class="text-muted small">¿No tienes cuenta? <a href="/register" class="fw-bold text-accent text-decoration-none" style="color: var(--accent-color)">Regístrate aquí</a></p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Toggle Password Visibility
  const togglePassword = document.querySelector('#togglePassword');
  const passwordInput = document.querySelector('#passwordInput');
  const toggleIcon = togglePassword.querySelector('i');

  togglePassword.addEventListener('click', function (e) {
    const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
    passwordInput.setAttribute('type', type);
    toggleIcon.classList.toggle('bi-eye-fill');
    toggleIcon.classList.toggle('bi-eye-slash-fill');
  });

  // Google Sign-In Handler
  const googleClientId = "<%= googleClientId || '' %>";

  async function handleGoogleLogin(response) {
    const cred = response ? (response.credential || response.token) : null;
    if (!cred) return;
    try {
      const res = await fetch('/auth/google', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ credential: cred, token: cred })
      });
      const data = await res.json();
      if (data.success) {
        window.location.href = data.redirectUrl || '/dashboard';
      } else {
        alert(data.error || 'Error al iniciar sesión con Google');
      }
    } catch (err) {
      console.error(err);
      alert('Error de conexión al autenticar con Google');
    }
  }

  document.getElementById('googleCustomBtn').addEventListener('click', () => {
    if (googleClientId && window.google) {
      google.accounts.id.prompt();
    } else {
      const promptCredential = prompt('Ingresa tu Google ID Token (o configura GOOGLE_CLIENT_ID en .env):');
      if (promptCredential) {
        handleGoogleLogin({ credential: promptCredential });
      }
    }
  });

  window.addEventListener('load', () => {
    const isLight = document.documentElement.getAttribute('data-theme') === 'light';
    const signinContainer = document.getElementById('g_id_signin');
    const customBtn = document.getElementById('googleCustomBtn');

    if (googleClientId && window.google && window.google.accounts) {
      try {
        google.accounts.id.initialize({
          client_id: googleClientId,
          callback: handleGoogleLogin,
          auto_select: false
        });

        if (signinContainer) {
          google.accounts.id.renderButton(signinContainer, {
            theme: isLight ? 'outline' : 'filled_black',
            size: 'large',
            width: signinContainer.offsetWidth || 340,
            shape: 'pill',
            text: 'continue_with',
            logo_alignment: 'left'
          });
          // Asegurar que el botón secundario permanezca oculto
          if (customBtn) customBtn.style.display = 'none';
        }
      } catch (e) {
        console.warn('Google GIS init error:', e);
        if (customBtn) customBtn.style.display = 'flex';
      }
    } else {
      if (customBtn) customBtn.style.display = 'flex';
    }
  });
</script>

<%- include('partials/footer') %>
