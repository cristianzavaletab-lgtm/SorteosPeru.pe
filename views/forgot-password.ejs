<%- include('partials/header') %>

<div class="container py-5" style="min-height: 75vh;">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card shadow p-4 p-md-5 border-0">
        <div class="text-center mb-4">
          <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 shadow-sm" style="width: 60px; height: 60px; background: rgba(124, 58, 237, 0.12); color: #7c3aed; font-size: 1.8rem;">
            <i class="bi bi-shield-lock-fill"></i>
          </div>
          <h2 class="fw-bold mb-1" style="color: var(--secondary-color);">Recuperar Contraseña</h2>
          <p class="text-muted small">Ingresa tu correo registrado para recibir las instrucciones de restablecimiento.</p>
        </div>

        <% if (locals.error) { %>
          <div class="alert alert-danger border-0 small py-3 mb-4 rounded-3 d-flex align-items-center">
            <i class="bi bi-exclamation-triangle-fill fs-5 me-2 flex-shrink-0"></i>
            <div><%= error %></div>
          </div>
        <% } %>

        <% if (locals.success) { %>
          <div class="alert alert-success border-0 small py-3 mb-4 rounded-3 d-flex align-items-center" style="background: rgba(16, 185, 129, 0.15); color: #10b981;">
            <i class="bi bi-check-circle-fill fs-5 me-2 flex-shrink-0"></i>
            <div><%= success %></div>
          </div>
        <% } %>
        
        <form action="/auth/forgot-password" method="POST">
          <div class="mb-4">
            <label class="form-label text-muted small fw-bold">Correo Electrónico</label>
            <div class="input-group">
              <span class="input-group-text bg-transparent border-end-0 text-muted">
                <i class="bi bi-envelope"></i>
              </span>
              <input type="email" class="form-control form-control-lg border-start-0" name="email" required placeholder="tu@correo.com" autofocus>
            </div>
            <div class="form-text small">Te enviaremos un enlace de un solo uso válido por 1 hora.</div>
          </div>

          <button type="submit" class="btn btn-primary btn-lg w-100 py-3 mb-3 fw-bold rounded-pill shadow-sm">
            <i class="bi bi-send-fill me-2"></i> Enviar Enlace de Recuperación
          </button>
        </form>
        
        <div class="text-center mt-3 pt-3 border-top border-secondary border-opacity-10">
          <a href="/login" class="text-decoration-none small text-muted d-inline-flex align-items-center">
            <i class="bi bi-arrow-left me-1"></i> Volver a Iniciar Sesión
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
